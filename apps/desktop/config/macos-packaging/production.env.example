# Copy to production.env and configure the production service before selecting this preset.
QILIN_DESKTOP_APP_ID=com.deepseek.harness
QILIN_DESKTOP_AUTO_UPDATE_ENV=production
QILIN_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
QILIN_DESKTOP_MACOS_PACK_CONCURRENCY=4
QILIN_DESKTOP_MACOS_DOWNLOAD_PROXY=
QILIN_DESKTOP_MACOS_NOTARIZATION_PROXY=
# Optional absolute private directory; setup fills this in for machine presets. Omit to use checkout-local storage.
# QILIN_DESKTOP_MACOS_SIGNATURE_CACHE_DIR=
