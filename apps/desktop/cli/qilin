#!/bin/sh
# Run the installed CLI without changing the invoking shell or working directory.
set -e
launcher=$0
while [ -L "$launcher" ]; do
  directory=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd -P)
  target=$(readlink "$launcher")
  case "$target" in
    /*) launcher=$target ;;
    *) launcher=$directory/$target ;;
  esac
done
resources=$(CDPATH= cd -- "$(dirname -- "$launcher")/../../.." && pwd -P)
# The installed CLI manages this installation own Harness home unless the caller names one.
if [ -z "${QILIN_HOME:-}" ]; then
  case "$(uname -s)" in
    Darwin) QILIN_HOME="$HOME/Library/Application Support/QiLin Desktop" ;;
    *) QILIN_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/QiLin Desktop" ;;
  esac
  export QILIN_HOME
fi
ELECTRON_RUN_AS_NODE=1 exec "$resources/../MacOS/QiLin Desktop" --expose-internals "$resources/app.asar/qilin/node_modules/@qilin-agent/desktop-host/lib/cli.js" "$@"
