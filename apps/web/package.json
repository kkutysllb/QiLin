{
  "name": "@qilin-agent/web-frontend",
  "description": "Web application entry: vite build over the @qilin-agent/client-web shell library; dist/ served by apps/cli's qilin web",
  "version": "3.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "apps/web"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "exports": {
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/preview.html",
    "!dist/preview"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "watch": "vite build --watch --no-emptyOutDir",
    "build:preview": "pnpm --filter @qilin-agent/experimental-webworker-runtime exec tsdown && pnpm --filter @qilin-agent/experimental-webworker-packer exec tsdown && vite build && qilin-pack-vfs-image --out dist/preview/vfs-image.tar.gz",
    "serve:preview": "http-server dist -a 0.0.0.0 -p 4173 -c-1"
  },
  "license": "MIT",
  "devDependencies": {
    "@qilin-agent/kylin-plugin-group": "workspace:~",
    "@qilin-agent/client-modules": "workspace:*",
    "@qilin-agent/client-store": "workspace:*",
    "@qilin-agent/client-test-runtime": "workspace:*",
    "@qilin-agent/client-ui-dockkit": "workspace:*",
    "@qilin-agent/client-ui-primitives": "workspace:*",
    "@qilin-agent/client-ui-slots": "workspace:*",
    "@qilin-agent/client-web": "workspace:*",
    "@qilin-agent/cmdline": "workspace:*",
    "@qilin-agent/pwsh-local": "workspace:*",
    "@qilin-agent/experimental-webworker-packer": "workspace:*",
    "@qilin-agent/experimental-webworker-runtime": "workspace:*",
    "@qilin-agent/remote-mock": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^4.0.0",
    "http-server": "^14.1.1",
    "fflate": "^0.8.2",
    "playwright": "^1.49.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.8",
    "ws": "8.21.0",
    "@qilin-agent/launch-environment": "workspace:*",
    "@qilin-agent/workspace-changes": "workspace:*",
    "@qilin-agent/subprocess-local": "workspace:*",
    "@qilin-agent/experimental-auto-review": "workspace:*",
    "@qilin-agent/experimental-speech-to-text": "workspace:*",
    "@qilin-agent/experimental-voice-input-bundle": "workspace:*"
  }
}
