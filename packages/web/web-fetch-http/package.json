{
  "name": "@qilin-agent/web-fetch-http",
  "description": "Anonymous public HTTP(S) fetch provider for the QiLin web capability seam (ctx.web)",
  "version": "3.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/web/web-fetch-http"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/timeout": "workspace:*",
    "@qilin-agent/web": "workspace:*",
    "@qilin-agent/http-proxy": "workspace:*"
  },
  "dependencies": {
    "@qilin-agent/schemastery": "workspace:~",
    "ipaddr.js": "^2.5.0",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/timeout": "workspace:*",
    "@qilin-agent/web": "workspace:*",
    "@qilin-agent/http-proxy": "workspace:*"
  }
