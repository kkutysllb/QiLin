{
  "name": "@qilin/web",
  "description": "Abstract web access capability seam (ctx.web) for the QiLin — search/fetch provider registry, registration-order-independent selection, request/result vocabulary, and the WebError taxonomy",
  "version": "3.0.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/web/web"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin/llm": "workspace:^",
    "@qilin/kylin": "workspace:^"
  },
  "dependencies": {
    "@qilin/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@qilin/llm": "workspace:^",
    "@qilin/kylin": "workspace:^"
  }
}
