  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/spill-local": "workspace:*",
    "@qilin-agent/spill-policy": "workspace:*",
    "@qilin-agent/system-prompt": "workspace:*",
    "@qilin-agent/tool-call-timeout-policy": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@qilin-agent/web": "workspace:*",
    "@qilin-agent/web-fetch-http": "workspace:*",
    "@qilin-agent/web-search-exa": "workspace:*",
    "@types/turndown": "^5.0.6",
