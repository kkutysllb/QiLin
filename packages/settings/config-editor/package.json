{
  "name": "@qilin-agent/config-editor",
  "description": "Persist plugin configuration through profile patches and Loader reconciliation",
  "version": "3.1.6-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/settings/config-editor"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/hmr": "workspace:*",
    "@qilin-agent/kylin-plugin-include": "workspace:~",
    "@qilin-agent/app-boot": "workspace:*"
  },
  "dependencies": {
    "@qilin-agent/atomic-write": "workspace:*",
    "yaml": "^2.8.1",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/hmr": "workspace:*",
    "@qilin-agent/kylin-plugin-include": "workspace:~",
    "@types/js-yaml": "^4.0.9",
    "@qilin-agent/app-boot": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@qilin-agent/hmr": {
      "optional": true
    }
  }
}
