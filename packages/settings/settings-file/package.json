{
  "name": "@qilin/settings-file",
  "description": "File-backed settings provider (settings.yaml) for the QiLin",
  "version": "3.0.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/settings/settings-file"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin/kylin": "workspace:^",
    "@qilin/atomic-write": "workspace:^",
    "@qilin/home-paths": "workspace:^",
    "@qilin/settings": "workspace:^"
  },
  "dependencies": {
    "@qilin/util-values": "workspace:^",
    "@qilin/schemastery": "workspace:^",
    "chokidar": "^4.0.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@qilin/kylin": "workspace:^",
    "@qilin/atomic-write": "workspace:^",
    "@qilin/home-paths": "workspace:^",
    "@qilin/settings": "workspace:^"
  }
}
