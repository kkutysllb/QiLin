{
  "name": "@qilin-agent/settings-file",
  "description": "File-backed settings provider (settings.yaml) for the QiLin",
  "version": "3.1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/settings/settings-file"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/atomic-write": "workspace:*",
    "@qilin-agent/home-paths": "workspace:*",
    "@qilin-agent/settings": "workspace:*"
  },
  "dependencies": {
    "@qilin-agent/util-values": "workspace:*",
    "@qilin-agent/schemastery": "workspace:~",
    "chokidar": "^4.0.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/atomic-write": "workspace:*",
    "@qilin-agent/home-paths": "workspace:*",
    "@qilin-agent/settings": "workspace:*"
  }
}
