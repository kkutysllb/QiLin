{
  "name": "@qilin-agent/mcp-client",
  "description": "MCP client bridge: connects to MCP servers and registers their tools on ctx.tools",
  "version": "3.1.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/mcp/mcp-client"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/attachment": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/scope": "workspace:*",
    "@qilin-agent/subprocess": "workspace:*",
    "@qilin-agent/timeout": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/mcp-resources": "workspace:*",
    "@qilin-agent/system-prompt": "workspace:*"
  },
  "dependencies": {
    "@qilin-agent/schemastery": "workspace:~",
    "@modelcontextprotocol/client": "2.0.0",
    "@qilin-agent/util-values": "workspace:*"
  },
  "devDependencies": {
    "@qilin-agent/attachment": "workspace:*",
    "@qilin-agent/attachment-local": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/scope": "workspace:*",
    "@qilin-agent/subprocess": "workspace:*",
    "@qilin-agent/timeout": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@modelcontextprotocol/server-everything": "^2026.7.4",
    "@modelcontextprotocol/server-filesystem": "^2026.7.4",
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/http-proxy": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "zod": "^4.4.3",
    "@qilin-agent/mcp-resources": "workspace:*",
    "@qilin-agent/system-prompt": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@qilin-agent/mcp-resources": {
      "optional": true
    },
    "@qilin-agent/system-prompt": {
      "optional": true
    }
  }
}
