{
  "name": "@qilin/client-ui-kylin",
  "description": "Kylin dynamic-plugin definition card: the keyed kylin_define tool row with its run/stop switch",
  "version": "0.1.6-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/extensions/ui-kylin"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "qilin": {
    "client": {
      "inject": [
        "@qilin/client-connection",
        "@qilin/kylin-client-runner",
        "@qilin/api-remotes",
        "@qilin/client-locale",
        "@qilin/client-ui-renderer",
        "@qilin/client-ui-session",
        "@qilin/client-ui-tool",
        "@qilin/client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@qilin/kylin": "workspace:^"
  },
  "devDependencies": {
    "@qilin/api-remotes": "workspace:^",
    "@qilin/client-connection": "workspace:^",
    "@qilin/kylin-client-runner": "workspace:^",
    "@qilin/client-locale": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/client-ui-primitives": "workspace:^",
    "@qilin/client-ui-sidebar": "workspace:^",
    "@qilin/client-ui-renderer": "workspace:^",
    "@qilin/client-ui-session": "workspace:^",
    "@qilin/client-ui-slots": "workspace:^",
    "@qilin/client-ui-tool": "workspace:^",
    "@types/react": "~18.3.1",
    "@qilin/kylin": "workspace:^",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
