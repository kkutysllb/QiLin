{
  "name": "@qilin-agent/client-ui-kylin",
  "description": "Kylin dynamic-plugin definition card: the keyed cordis_define tool row with its run/stop switch",
  "version": "3.1.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/extensions/ui-kylin"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "qilin": {
    "client": {
      "inject": [
        "@qilin-agent/client-connection",
        "@qilin-agent/kylin-client-runner",
        "@qilin-agent/api-remotes",
        "@qilin-agent/client-locale",
        "@qilin-agent/client-ui-renderer",
        "@qilin-agent/client-ui-session",
        "@qilin-agent/client-ui-tool",
        "@qilin-agent/client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/api-remotes": "workspace:*",
    "@qilin-agent/client-connection": "workspace:*",
    "@qilin-agent/kylin-client-runner": "workspace:*",
    "@qilin-agent/client-locale": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/client-ui-primitives": "workspace:*",
    "@qilin-agent/client-ui-sidebar": "workspace:*",
    "@qilin-agent/client-ui-renderer": "workspace:*",
    "@qilin-agent/client-ui-session": "workspace:*",
    "@qilin-agent/client-ui-slots": "workspace:*",
    "@qilin-agent/client-ui-tool": "workspace:*",
    "@types/react": "~18.3.1",
    "@qilin-agent/kylin": "workspace:~",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
