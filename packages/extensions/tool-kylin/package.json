{
  "name": "@qilin-agent/tool-kylin",
  "description": "Read-only runtime API inspection for Harness plugin development",
  "version": "3.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/extensions/tool-kylin"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./host": {
      "types": "./lib/types/host.d.ts",
      "default": "./lib/types/host.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/app-boot": "workspace:*",
    "@qilin-agent/kylin-host-runner": "workspace:*",
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/system-prompt": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@qilin-agent/kylin": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/app-boot": "workspace:*",
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/kylin-host-runner": "workspace:*",
    "@qilin-agent/system-prompt": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@qilin-agent/kylin": "workspace:~"
  }
}
