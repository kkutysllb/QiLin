{
  "name": "@qilin-agent/command-feedback",
  "description": "Log-only session feedback: the record event, the sessionFeedback Host Remote, and the human-facing slash command",
  "version": "3.1.4-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/feedback/command-feedback"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/commands": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/anonymous-user-id": "workspace:*",
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/typert-protocol": "workspace:*"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@qilin-agent/kylin-plugin-include": "workspace:~",
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/agent-loop-testkit": "workspace:*",
    "@qilin-agent/commands": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/anonymous-user-id": "workspace:*",
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/typert-protocol": "workspace:*"
  }
}
