{
  "name": "@qilin-agent/session-format-v4-to-v5",
  "description": "Retired shipped preset vocabulary migration from Session V4 to V5",
  "version": "3.1.7-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/session/session-format-v4-to-v5"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "sessionFormatMigration": {
      "from": 4,
      "to": 5,
      "export": ".",
      "migration": "sessionFormatV4ToV5",
      "sourceCodec": "releasedV4SessionFormatCodec",
      "targetCodec": "releasedV5SessionFormatCodec",
      "targetHeaderValidator": "assertReleasedV5Header",
      "targetRestorer": "restoreReleasedV5Artifact"
    }
  },
  "dependencies": {
    "@qilin-agent/session-format": "workspace:*",
    "@qilin-agent/session-format-v2-to-v3": "workspace:*",
    "@qilin-agent/session-format-v3-to-v4": "workspace:*"
  },
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~"
  },
  "qilin": {
    "sessionFormatMigration": {
      "from": 4,
      "to": 5,
      "export": ".",
      "migration": "sessionFormatV4ToV5",
      "sourceCodec": "releasedV4SessionFormatCodec",
      "targetCodec": "releasedV5SessionFormatCodec",
      "targetHeaderValidator": "assertReleasedV5Header",
      "targetRestorer": "restoreReleasedV5Artifact"
    }
  }
}
