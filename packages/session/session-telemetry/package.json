{
  "name": "@qilin-agent/session-telemetry",
  "description": "SessionTelemetryBackend seam for the QiLin: session-event capture, projection, redaction, and handoff to a reporting backend",
  "version": "3.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
