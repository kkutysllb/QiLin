{
  "name": "@qilin-agent/session-persistence-jsonl",
  "description": "JSONL durable session persistence backend for the QiLin",
  "version": "3.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/session/session-persistence-jsonl"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/worker.cjs",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/session-persistence": "workspace:*",
    "@qilin-agent/kylin": "workspace:~"
  },
  "dependencies": {
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/session-format": "workspace:*",
    "@qilin-agent/session-format-catalog": "workspace:*",
    "@qilin-agent/session-format-v2-to-v3": "workspace:*",
    "@qilin-agent/node-addon-system": "workspace:~",
    "koffi": "3.1.1",
    "@qilin-agent/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/session-format-v0-to-v1": "workspace:*",
    "@qilin-agent/session-persistence": "workspace:*",
    "@qilin-agent/kylin": "workspace:~"
  }
}
