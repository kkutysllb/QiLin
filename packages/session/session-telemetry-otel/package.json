{
  "name": "@qilin/session-telemetry-otel",
  "description": "OpenTelemetry backend for the QiLin telemetry seam: hands captured session records to the OTel JS SDK's log pipeline",
  "version": "3.0.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/session/session-telemetry-otel"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.220.0",
    "@opentelemetry/otlp-exporter-base": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-logs": "^0.220.0",
    "@qilin/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@qilin/command-feedback": "workspace:^",
    "@qilin/message-feedback": "workspace:^",
    "@qilin/llm": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/session-telemetry": "workspace:^",
    "@qilin/anonymous-user-id": "workspace:^",
    "@qilin/kylin": "workspace:^"
  },
  "devDependencies": {
    "@qilin/kylin-plugin-logger-console": "workspace:^",
    "@qilin/kylin-plugin-loader": "workspace:^",
    "@qilin/app-boot": "workspace:^",
    "@qilin/bash-local": "workspace:^",
    "@qilin/command-feedback": "workspace:^",
    "@qilin/message-feedback": "workspace:^",
    "@qilin/llm": "workspace:^",
    "@qilin/loader-smoke": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/session-checkpoint-policy": "workspace:^",
    "@qilin/session-persistence-jsonl": "workspace:^",
    "@qilin/session-telemetry": "workspace:^",
    "@qilin/subprocess-local": "workspace:^",
    "@qilin/anonymous-user-id": "workspace:^",
    "@qilin/kylin": "workspace:^",
    "@qilin/http-proxy": "workspace:^"
  }
}
