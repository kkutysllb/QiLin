{
  "name": "@qilin-agent/session-log-deepseek",
  "description": "Incremental lossless session-log request extension for the official DeepSeek LLM API",
  "version": "3.1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/session/session-log-deepseek"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@qilin-agent/brand": "workspace:*",
    "@qilin-agent/util-values": "workspace:*",
    "@qilin-agent/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/deepseek-llm-api-extensions": "workspace:*",
    "@qilin-agent/session": "workspace:*"
  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/kylin-plugin-include": "workspace:~",
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/command-feedback": "workspace:*",
    "@qilin-agent/deepseek-llm-api-extensions": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/llm-deepseek": "workspace:*",
    "@qilin-agent/llm-deepseek-api-key": "workspace:*",
    "@qilin-agent/llm-mock-server": "workspace:*",
    "@qilin-agent/message-feedback": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/session-persistence-jsonl": "workspace:*"
  }
}
