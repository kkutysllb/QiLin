{
  "name": "@qilin-agent/sidebar-opens",
  "description": "Model-facing requests to open a file or an http(s) page in the Session's Sidebar",
  "version": "3.1.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/host/sidebar-opens"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "dependencies": {
    "@qilin-agent/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/fs": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@qilin-agent/typert-protocol": "workspace:*"
  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/agent-loop-testkit": "workspace:*",
    "@qilin-agent/fs": "workspace:*",
    "@qilin-agent/fs-local": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/scope": "workspace:*",
    "@qilin-agent/system-prompt": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@qilin-agent/typert-protocol": "workspace:*"
  }
}
