{
  "name": "@qilin/host-frontend-static",
  "description": "SPA dist server for the Web shell: owns the webserver fallback seat, serving explicit index entries and static assets with traversal rejection and 404 misses",
  "version": "0.1.6-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/host/frontend-static"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin/host-webserver": "workspace:^",
    "@qilin/client-connection": "workspace:^",
    "@qilin/kylin": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@qilin/kylin-plugin-loader": "workspace:^",
    "@qilin/client-connection": "workspace:^",
    "@qilin/credentials-local": "workspace:^",
    "@qilin/host-webserver": "workspace:^",
    "@qilin/kylin": "workspace:^"
  }
}
