{
  "name": "@qilin-agent/host-directory-picker-auto",
  "description": "Adaptive chooser of the directory-picker seam: resolves the host situation at boot and mounts the native or browse backend for the QiLin web GUI host",
  "version": "3.1.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/host/directory-picker-auto"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/client-ui-directory-picker-browse": "workspace:*",
    "@qilin-agent/client-ui-directory-picker-native": "workspace:*",
    "@qilin-agent/host-directory-picker-browse": "workspace:*",
    "@qilin-agent/host-directory-picker-native": "workspace:*",
    "@qilin-agent/host-webserver": "workspace:*"
  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/kylin-plugin-include": "workspace:~",
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/client-ui-directory-picker-browse": "workspace:*",
    "@qilin-agent/client-ui-directory-picker-native": "workspace:*",
    "@qilin-agent/host-directory-picker": "workspace:*",
    "@qilin-agent/host-directory-picker-browse": "workspace:*",
    "@qilin-agent/host-directory-picker-native": "workspace:*",
    "@qilin-agent/host-webserver": "workspace:*"
  },
  "dependencies": {
    "@qilin-agent/launch-environment": "workspace:*"
  }
}
