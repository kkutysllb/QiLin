{
  "name": "@qilin-agent/token-meter",
  "description": "Replay-aware token measurement service (ctx.tokenMeter) for the QiLin",
  "version": "3.1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/llm/token-meter"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./estimate": {
      "types": "./lib/types/estimate.d.ts",
      "default": "./lib/types/estimate.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/compaction": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/llm-retry": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/session-projection": "workspace:*",
    "@qilin-agent/compaction-image-offload": "workspace:*"
  },
  "dependencies": {
    "@qilin-agent/util-values": "workspace:*",
    "@qilin-agent/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/compaction": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/llm-retry": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/session-projection": "workspace:*",
    "@qilin-agent/compaction-image-offload": "workspace:*"
  }
}
