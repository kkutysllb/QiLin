{
  "name": "@qilin-agent/llm",
  "description": "Provider-neutral LLM service interface for the QiLin",
  "version": "3.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/llm/llm"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./brand": {
      "types": "./lib/types/brand.d.ts",
      "default": "./lib/types/brand.js"
    },
    "./message": {
      "types": "./lib/types/message.d.ts",
      "default": "./lib/types/message.js"
    },
    "./assistant-stream": {
      "types": "./lib/types/assistant-stream.d.ts",
      "default": "./lib/types/assistant-stream.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~"
  },
  "dependencies": {
    "@qilin-agent/util-crypto": "workspace:*",
    "@qilin-agent/schemastery": "workspace:~",
    "zod": "^4.4.3",
    "@qilin-agent/timeout": "workspace:*",
    "@qilin-agent/brand": "workspace:*",
    "@qilin-agent/util-values": "workspace:*",
    "@qilin-agent/typert-protocol": "workspace:*"
  },
  "devDependencies": {
    "@qilin-agent/attachment": "workspace:*",
    "@qilin-agent/kylin": "workspace:~"
  }
}
