{
  "name": "@qilin/office-to-pdf",
  "description": "Shared Office-to-PDF conversion with bounded queues and caching",
  "version": "3.0.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/document/office-to-pdf"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "peerDependencies": {
    "@qilin/kylin": "workspace:^"
  },
  "devDependencies": {
    "@qilin/kylin": "workspace:^",
    "@qilin/kylin-plugin-loader": "workspace:^",
    "@qilin/kylin-plugin-include": "workspace:^",
    "@qilin/api-workspace-files": "workspace:^",
    "@qilin/fs": "workspace:^",
    "@qilin/session": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/libreoffice-kit": "0.0.1",
    "@qilin/schemastery": "workspace:^",
    "@qilin/brand": "workspace:^",
    "@qilin/typert-protocol": "workspace:^",
    "zod": "^4.4.3"
  }
}
