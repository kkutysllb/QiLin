{
  "name": "@qilin/lsp",
  "description": "Abstract LSP capability seam (ctx.lsp) for the QiLin — language-server provider registry keyed by branded id and extension mapping, order-independent per-query selection, normalized definition/references/implementation/hover requests and results, and the LspError taxonomy",
  "version": "3.0.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/lsp/lsp"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin/brand": "workspace:^",
    "@qilin/llm": "workspace:^",
    "@qilin/kylin": "workspace:^"
  },
  "devDependencies": {
    "@qilin/brand": "workspace:^",
    "@qilin/llm": "workspace:^",
    "@qilin/kylin": "workspace:^"
  }
}
