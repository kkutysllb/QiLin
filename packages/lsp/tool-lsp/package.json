{
  "name": "@qilin/tool-lsp",
  "description": "Model-facing lsp tool over the QiLin LSP capability seam (ctx.lsp) — one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "3.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin/kylin": "workspace:^",
    "@qilin/llm": "workspace:^",
    "@qilin/lsp": "workspace:^",
    "@qilin/system-prompt": "workspace:^",
    "@qilin/timeout": "workspace:^",
    "@qilin/tools": "workspace:^"
  },
  "dependencies": {
    "@qilin/util-values": "workspace:^",
    "@qilin/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@qilin/kylin": "workspace:^",
    "@qilin/agent": "workspace:^",
    "@qilin/fs-local": "workspace:^",
    "@qilin/llm": "workspace:^",
    "@qilin/lsp": "workspace:^",
    "@qilin/lsp-stdio": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/subprocess-local": "workspace:^",
    "@qilin/system-prompt": "workspace:^",
    "@qilin/timeout": "workspace:^",
    "@qilin/tool-call-timeout-policy": "workspace:^",
    "@qilin/tools": "workspace:^"
  }
}
