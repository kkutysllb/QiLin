{
  "name": "@qilin/terminal-bash",
  "description": "Persistent shell PTY backend over the QiLin subprocess terminal primitive",
  "version": "3.0.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin/agent": "workspace:^",
    "@qilin/terminal": "workspace:^",
    "@qilin/sandbox": "workspace:^",
    "@qilin/sandbox-policy": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/subprocess": "workspace:^",
    "@qilin/kylin": "workspace:^",
    "@qilin/session-projection": "workspace:^"
  },
  "dependencies": {
    "@qilin/lazy-require": "workspace:^",
    "@qilin/pwsh-local": "workspace:^",
    "@qilin/schemastery": "workspace:^",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@qilin/agent": "workspace:^",
    "@qilin/agent-loop-testkit": "workspace:^",
    "@qilin/terminal": "workspace:^",
    "@qilin/sandbox": "workspace:^",
    "@qilin/sandbox-policy": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/subprocess": "workspace:^",
    "@qilin/subprocess-local": "workspace:^",
    "@qilin/kylin": "workspace:^"
  }
}
