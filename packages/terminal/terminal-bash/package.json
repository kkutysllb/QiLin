{
  "name": "@qilin-agent/terminal-bash",
  "description": "Persistent shell PTY backend over the QiLin subprocess terminal primitive",
  "version": "3.1.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/terminal": "workspace:*",
    "@qilin-agent/sandbox": "workspace:*",
    "@qilin-agent/sandbox-policy": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/subprocess": "workspace:*",
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/session-projection": "workspace:*"
  },
  "dependencies": {
    "@qilin-agent/lazy-require": "workspace:*",
    "@qilin-agent/pwsh-local": "workspace:*",
    "@qilin-agent/schemastery": "workspace:~",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/agent-loop-testkit": "workspace:*",
    "@qilin-agent/terminal": "workspace:*",
    "@qilin-agent/sandbox": "workspace:*",
    "@qilin-agent/sandbox-policy": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/subprocess": "workspace:*",
    "@qilin-agent/subprocess-local": "workspace:*",
    "@qilin-agent/kylin": "workspace:~"
  }
}
