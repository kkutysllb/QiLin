{
  "name": "@qilin/util-values",
  "description": "Duplicate-install-safe value primitives for the QiLin",
  "version": "0.1.6-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/util/values"
  },
  "type": "module",
  "main": "lib/index.js",
