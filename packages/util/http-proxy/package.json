{
  "name": "@qilin/http-proxy",
  "description": "Process-wide outbound HTTP proxy policy for QiLin: resolve it from the launch environment and install it as undici's global dispatcher",
  "version": "3.0.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/util/http-proxy"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin/kylin": "workspace:^"
  },
  "dependencies": {
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@qilin/kylin": "workspace:^",
    "@qilin/invariants": "workspace:^"
  }
}
