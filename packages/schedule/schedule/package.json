{
  "name": "@qilin-agent/schedule",
  "description": "Host-wide durable reminders with shared management and original-Session delivery",
  "version": "3.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/schedule/schedule"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/api-session-controller": "workspace:*",
    "@qilin-agent/brand": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/session-persistence": "workspace:*",
    "@qilin-agent/session-projection": "workspace:*",
    "@qilin-agent/storage-domain": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@qilin-agent/typert-protocol": "workspace:*",
    "@qilin-agent/kylin": "workspace:~"
  },
  "dependencies": {
    "@qilin-agent/schemastery": "workspace:~",
    "@js-temporal/polyfill": "0.5.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/agent-loop": "workspace:*",
    "@qilin-agent/agent-loop-testkit": "workspace:*",
    "@qilin-agent/api-session-controller": "workspace:*",
    "@qilin-agent/brand": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/session-persistence": "workspace:*",
    "@qilin-agent/session-persistence-jsonl": "workspace:*",
    "@qilin-agent/session-projection": "workspace:*",
    "@qilin-agent/storage": "workspace:*",
    "@qilin-agent/storage-domain": "workspace:*",
    "@qilin-agent/storage-json": "workspace:*",
    "@qilin-agent/system-prompt": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@qilin-agent/typert-protocol": "workspace:*",
    "@qilin-agent/kylin": "workspace:~"
  }
}
