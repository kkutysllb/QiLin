{
  "name": "@qilin-agent/deliverable-file-references",
  "description": "Shared model guidance for file links and deliverables across QiLin hosts",
  "version": "3.1.8-rc.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/deliverables/deliverable-file-references"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
