{
  "name": "@qilin-agent/skill-filesystem",
  "description": "Local filesystem skill provider for the QiLin",
  "version": "3.1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/skill/skill-filesystem"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/fs": "workspace:*",
    "@qilin-agent/home-paths": "workspace:*",
    "@qilin-agent/skill": "workspace:*",
    "@qilin-agent/kylin": "workspace:~"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "@qilin-agent/schemastery": "workspace:~",
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@qilin-agent/fs": "workspace:*",
    "@qilin-agent/home-paths": "workspace:*",
    "@qilin-agent/skill": "workspace:*",
    "@qilin-agent/kylin": "workspace:~"
  }
}
