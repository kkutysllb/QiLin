{
  "name": "@qilin-agent/experimental-client-ui-stats",
  "description": "Per-turn and per-step context, timing, cache, and tool-cost table contributed as an experimental conversation View",
  "version": "3.1.8-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/experimental/client-ui-stats"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "qilin": {
    "client": {
      "inject": [
        "@qilin-agent/api-session-controller",
        "@qilin-agent/client-locale",
        "@qilin-agent/client-ui-conversation",
        "@qilin-agent/client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/api-session-controller": "workspace:*",
    "@qilin-agent/attachment": "workspace:*",
    "@qilin-agent/client-locale": "workspace:*",
    "@qilin-agent/client-store": "workspace:*",
    "@qilin-agent/client-test-runtime": "workspace:*",
    "@qilin-agent/client-ui-conversation": "workspace:*",
    "@qilin-agent/client-ui-primitives": "workspace:*",
    "@qilin-agent/client-ui-renderer": "workspace:*",
    "@qilin-agent/client-ui-session": "workspace:*",
    "@qilin-agent/client-ui-slots": "workspace:*",
    "@qilin-agent/compaction": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/llm-retry": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/session-stats": "workspace:*",
    "@qilin-agent/token-meter": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@qilin-agent/user-approval": "workspace:*",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@testing-library/react": "^16.1.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
