{
  "name": "@qilin/experimental-voice-input-bundle",
  "description": "Experimental voice input with local SenseVoice; downloads its runtime on first use",
  "version": "3.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/experimental/voice-input-bundle"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@qilin/experimental-speech-to-text": "workspace:*",
    "@qilin/experimental-speech-to-text-sensevoice": "workspace:*",
    "@qilin/experimental-api-speech-to-text": "workspace:*",
    "@qilin/experimental-client-ui-voice-input": "workspace:*"
  },
  "peerDependencies": {
    "@qilin/kylin": "workspace:~"
  },
  "devDependencies": {
    "@qilin/kylin": "workspace:~",
    "@qilin/kylin-plugin-include": "workspace:~",
    "js-yaml": "^4.2.0"
  },
  "qilin": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
