{
  "name": "@qilin-agent/experimental-browser-use-chrome-devtools-mcp",
  "description": "Experimental per-Session Chromium browser tools through chrome-devtools-mcp",
  "version": "3.1.4-rc.1",
  "publishConfig": {
    "access": "public"
  },
