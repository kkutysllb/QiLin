{
  "name": "@qilin-agent/experimental-cua-macos",
  "description": "macOS native provider for shared Computer Use application and window objects",
  "version": "3.1.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/experimental/cua-macos"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "native/bin",
    "native/Package.swift",
    "native/Sources",
    "native/tests/swift",
    "native/tests/test_swift.py",
    "native/LICENSE.cua-driver",
    "native/upstream.json",
    "native/README.md",
    "native/README.zh.md",
    "native/protocol.schema.json",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/computer-use": "workspace:*",
    "@qilin-agent/system-prompt": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/subprocess": "workspace:*",
    "@qilin-agent/user-questions": "workspace:*"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@qilin-agent/atomic-write": "workspace:*",
    "@qilin-agent/experimental-cua": "workspace:*"
  },
  "devDependencies": {
    "@qilin-agent/working-directory": "workspace:*",
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/kylin-plugin-include": "workspace:~",
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/agent-loop": "workspace:*",
    "@qilin-agent/agent-loop-testkit": "workspace:*",
    "@qilin-agent/attachment": "workspace:*",
    "@qilin-agent/attachment-local": "workspace:*",
    "@qilin-agent/computer-use": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/session-projection": "workspace:*",
    "@qilin-agent/system-prompt": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@qilin-agent/subprocess": "workspace:*",
    "@qilin-agent/subprocess-local": "workspace:*",
    "@qilin-agent/fs-local": "workspace:*",
    "@qilin-agent/llm-deepseek": "workspace:*",
    "@qilin-agent/ptc-runtime-node": "workspace:*",
    "@qilin-agent/sandbox-local": "workspace:*",
    "@qilin-agent/sandbox-policy": "workspace:*",
    "sharp": "^0.35.5",
    "@qilin-agent/ptc-runtime": "workspace:*",
    "@qilin-agent/user-questions": "workspace:*",
    "@qilin-agent/settings": "workspace:*",
    "@qilin-agent/app-boot": "workspace:*",
    "@qilin-agent/config-editor": "workspace:*",
    "@qilin-agent/hmr": "workspace:*",
    "@qilin-agent/kylin-plugin-timer": "workspace:~"
  },
  "scripts": {
    "build:native": "swift build --package-path native --configuration release"
  }
}
