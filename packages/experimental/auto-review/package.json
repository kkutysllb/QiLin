{
  "name": "@qilin-agent/experimental-auto-review",
  "description": "Per-tool LLM authorization review for the QiLin Auto permission preset",
  "icon": "./icon.svg",
  "version": "3.1.4-rc.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/experimental/auto-review"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/agent-instructions": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/permission-presets": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@qilin-agent/working-directory": "workspace:*",
    "@qilin-agent/kylin": "workspace:~"
  },
  "dependencies": {
    "@qilin-agent/util-values": "workspace:*"
  },
  "devDependencies": {
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/agent-instructions": "workspace:*",
    "@qilin-agent/agent-loop": "workspace:*",
    "@qilin-agent/agent-loop-testkit": "workspace:*",
    "@qilin-agent/bash-sandbox": "workspace:*",
    "@qilin-agent/compaction": "workspace:*",
    "@qilin-agent/fs-local": "workspace:*",
    "@qilin-agent/fs-observation-policy": "workspace:*",
    "@qilin-agent/fs-sandbox": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/llm-deepseek": "workspace:*",
    "@qilin-agent/llm-deepseek-api-key": "workspace:*",
    "@qilin-agent/permission-presets": "workspace:*",
    "@qilin-agent/ptc-runtime-node": "workspace:*",
    "@qilin-agent/sandbox": "workspace:*",
    "@qilin-agent/sandbox-policy": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/session-projection": "workspace:*",
    "@qilin-agent/shell": "workspace:*",
    "@qilin-agent/shell-env": "workspace:*",
    "@qilin-agent/subagent": "workspace:*",
    "@qilin-agent/subprocess-local": "workspace:*",
    "@qilin-agent/system-prompt": "workspace:*",
    "@qilin-agent/tool-bash": "workspace:*",
    "@qilin-agent/tool-fs": "workspace:*",
    "@qilin-agent/tool-subagent": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@qilin-agent/user-approval": "workspace:*",
    "@qilin-agent/working-directory": "workspace:*",
    "@qilin-agent/kylin": "workspace:~"
  },
  "publishConfig": {
    "access": "public"
  },
  "qilin": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
