{
  "name": "@qilin/experimental-auto-review",
  "description": "Per-tool LLM authorization review for the QiLin Auto permission preset",
  "version": "3.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/auto-review"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin/agent": "workspace:^",
    "@qilin/agent-instructions": "workspace:^",
    "@qilin/llm": "workspace:^",
    "@qilin/permission-presets": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/tools": "workspace:^",
    "@qilin/kylin": "workspace:^"
  },
  "dependencies": {
    "@qilin/util-values": "workspace:^"
  },
  "devDependencies": {
    "@qilin/agent": "workspace:^",
    "@qilin/agent-instructions": "workspace:^",
    "@qilin/agent-loop": "workspace:^",
    "@qilin/agent-loop-testkit": "workspace:^",
    "@qilin/bash-sandbox": "workspace:^",
    "@qilin/compaction": "workspace:^",
    "@qilin/fs-local": "workspace:^",
    "@qilin/fs-observation-policy": "workspace:^",
    "@qilin/fs-sandbox": "workspace:^",
    "@qilin/llm": "workspace:^",
    "@qilin/llm-deepseek": "workspace:^",
    "@qilin/permission-presets": "workspace:^",
    "@qilin/ptc-runtime-node": "workspace:^",
    "@qilin/sandbox": "workspace:^",
    "@qilin/sandbox-policy": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/session-projection": "workspace:^",
    "@qilin/shell": "workspace:^",
    "@qilin/shell-env": "workspace:^",
    "@qilin/subagent": "workspace:^",
    "@qilin/subprocess-local": "workspace:^",
    "@qilin/system-prompt": "workspace:^",
    "@qilin/tool-bash": "workspace:^",
    "@qilin/tool-fs": "workspace:^",
    "@qilin/tool-subagent": "workspace:^",
    "@qilin/tools": "workspace:^",
    "@qilin/user-approval": "workspace:^",
    "@qilin/kylin": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "qilin": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
