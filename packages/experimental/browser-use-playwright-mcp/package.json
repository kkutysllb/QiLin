{
  "name": "@qilin/experimental-browser-use-playwright-mcp",
  "description": "Experimental per-Session Chromium browser tools through @playwright/mcp",
  "version": "3.0.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/experimental/browser-use-playwright-mcp"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@qilin/experimental-browser-use-runtime": "workspace:^",
    "@playwright/mcp": "0.0.80"
  },
  "peerDependencies": {
    "@qilin/kylin": "workspace:^",
    "@qilin/browser-use": "workspace:^",
    "@qilin/agent": "workspace:^",
    "@qilin/tools": "workspace:^",
    "@qilin/system-prompt": "workspace:^"
  },
  "devDependencies": {
    "@qilin/kylin": "workspace:^",
    "@qilin/kylin-plugin-loader": "workspace:^",
    "@qilin/kylin-plugin-include": "workspace:^",
    "@qilin/browser-use": "workspace:^",
    "@qilin/agent": "workspace:^",
    "@qilin/agent-loop": "workspace:^",
    "@qilin/llm": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/tools": "workspace:^",
    "@qilin/system-prompt": "workspace:^",
    "@qilin/session-projection": "workspace:^"
  }
}
