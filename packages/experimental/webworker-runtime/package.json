{
  "name": "@qilin-agent/experimental-webworker-runtime",
  "description": "Browser-only harness runtime: in-memory VFS, module transform and loader, postMessage tunnel, and the dedicated Web Worker assembly, with the Node-compatibility layer that lets the host tree run unchanged",
  "version": "3.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/experimental/webworker-runtime"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./worker": "./lib/worker.js",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@qilin-agent/util-crypto": "workspace:*",
    "@noble/hashes": "^2.3.0",
    "@yarnpkg/parsers": "^3.1.0",
    "acorn": "^8.17.0",
    "buffer": "^6.0.3",
    "picomatch": "^4.0.4",
    "readable-stream": "^4.7.0",
    "@qilin-agent/client-web": "workspace:*"
  },
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/client-connection": "workspace:*",
    "@qilin-agent/client-modules": "workspace:*",
    "@qilin-agent/host-webserver": "workspace:*"
  },
  "devDependencies": {
    "@qilin-agent/api-gateway": "workspace:*",
    "@qilin-agent/bash-sandbox": "workspace:*",
    "@qilin-agent/client-connection": "workspace:*",
    "@qilin-agent/client-file-upload": "workspace:*",
    "@qilin-agent/client-modules": "workspace:*",
    "@qilin-agent/host-webserver": "workspace:*",
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/node-addon-system": "workspace:~",
    "@qilin-agent/sandbox-local": "workspace:*",
    "@qilin-agent/sandbox-policy": "workspace:*",
    "@qilin-agent/schedule": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/session-persistence-jsonl": "workspace:*",
    "@qilin-agent/session-projection": "workspace:*",
    "@qilin-agent/subagent": "workspace:*",
    "@qilin-agent/subprocess-local": "workspace:*",
    "@types/picomatch": "^3.0.2",
    "@types/readable-stream": "^4.0.24",
    "chokidar": "^5.0.0"
  },
  "files": [
    "lib/index.js",
    "lib/worker.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
