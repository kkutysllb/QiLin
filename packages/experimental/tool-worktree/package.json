{
  "name": "@qilin-agent/experimental-tool-worktree",
  "description": "Model tool that creates and enters a new Git worktree",
  "version": "3.1.4-rc.1",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/experimental/tool-worktree"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@qilin-agent/experimental-worktree": "workspace:*"
  },
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/tools": "workspace:*"
  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/kylin-plugin-include": "workspace:~",
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/agent-loop": "workspace:*",
    "@qilin-agent/experimental-worktree": "workspace:*",
    "@qilin-agent/fs-local": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/sandbox-local": "workspace:*",
    "@qilin-agent/sandbox-policy": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/session-projection": "workspace:*",
    "@qilin-agent/subprocess-local": "workspace:*",
    "@qilin-agent/system-prompt": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@qilin-agent/working-directory": "workspace:*"
  },
  "qilin": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
