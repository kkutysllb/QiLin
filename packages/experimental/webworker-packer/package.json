{
  "name": "@qilin-agent/experimental-webworker-packer",
  "description": "Build-time packer for the browser runtime's base VFS image and ordered data-overlay archives",
  "version": "3.1.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/experimental/webworker-packer"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "qilin-pack-vfs-image": "./bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/bin.js",
    "bin.js",
    "lib/repository-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@qilin-agent/kylin-plugin-include": "workspace:~",
    "@qilin-agent/experimental-webworker-runtime": "workspace:*",
    "@qilin-agent/home-paths": "workspace:*",
    "js-yaml": "^4.2.0",
    "picomatch": "^4.0.4"
  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@types/js-yaml": "^4.0.9",
    "@types/picomatch": "^3.0.2"
  },
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~"
  }
}
