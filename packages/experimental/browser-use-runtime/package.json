{
  "name": "@qilin-agent/experimental-browser-use-runtime",
  "description": "Session-owned browser resource lifecycles and MCP integration for experimental providers",
  "version": "3.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/experimental/browser-use-runtime"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./mcp": {
      "types": "./lib/types/mcp.d.ts",
      "default": "./lib/types/mcp.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/browser-use": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@qilin-agent/system-prompt": "workspace:*"
  },
  "dependencies": {
    "@qilin-agent/mcp-client": "workspace:*",
    "@qilin-agent/scope": "workspace:*",
    "@qilin-agent/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/browser-use": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@qilin-agent/agent-loop-testkit": "workspace:*",
    "@qilin-agent/agent-loop": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/session-projection": "workspace:*",
    "@qilin-agent/system-prompt": "workspace:*",
    "@qilin-agent/mcp-resources": "workspace:*",
    "@qilin-agent/ptc-runtime": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/kylin-plugin-include": "workspace:~",
    "@qilin-agent/attachment-local": "workspace:*",
    "@qilin-agent/session-persistence-jsonl": "workspace:*"
  }
}
