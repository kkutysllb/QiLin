{
  "name": "@qilin/experimental-browser-use-runtime",
  "description": "Session-owned browser resource lifecycles and MCP integration for experimental providers",
  "version": "0.1.6-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/browser-use-runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./mcp": {
      "types": "./lib/types/mcp.d.ts",
      "default": "./lib/types/mcp.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin/kylin": "workspace:^",
    "@qilin/agent": "workspace:^",
    "@qilin/browser-use": "workspace:^",
    "@qilin/tools": "workspace:^",
    "@qilin/system-prompt": "workspace:^"
  },
  "dependencies": {
    "@qilin/mcp-client": "workspace:^",
    "@qilin/scope": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@qilin/kylin": "workspace:^",
    "@qilin/agent": "workspace:^",
    "@qilin/browser-use": "workspace:^",
    "@qilin/tools": "workspace:^",
    "@qilin/agent-loop-testkit": "workspace:^",
    "@qilin/agent-loop": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/session-projection": "workspace:^",
    "@qilin/system-prompt": "workspace:^",
    "@qilin/mcp-resources": "workspace:^",
    "@qilin/ptc-runtime": "workspace:^",
    "@qilin/llm": "workspace:^",
    "@qilin/kylin-plugin-loader": "workspace:^",
    "@qilin/kylin-plugin-include": "workspace:^",
    "@qilin/attachment-local": "workspace:^",
    "@qilin/session-persistence-jsonl": "workspace:^"
  }
}
