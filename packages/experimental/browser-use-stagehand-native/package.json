{
  "name": "@qilin/experimental-browser-use-stagehand-native",
  "description": "Experimental Stagehand browser tools with separately configured native models",
  "version": "3.0.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/experimental/browser-use-stagehand-native"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./worker": {
      "types": "./lib/types/worker.d.ts",
      "default": "./lib/worker.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/worker.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin/kylin": "workspace:^",
    "@qilin/agent": "workspace:^",
    "@qilin/browser-use": "workspace:^",
    "@qilin/system-prompt": "workspace:^",
    "@qilin/tools": "workspace:^"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "4.1.0",
    "@qilin/experimental-browser-use-runtime": "workspace:^",
    "@qilin/mcp-client": "workspace:^",
    "@qilin/util-values": "workspace:^",
    "@qilin/schemastery": "workspace:^",
    "zod": "^4.4.3",
    "@qilin/subprocess": "workspace:^",
    "@puppeteer/browsers": "3.2.2"
  },
  "devDependencies": {
    "@qilin/kylin": "workspace:^",
    "@qilin/kylin-plugin-include": "workspace:^",
    "@qilin/kylin-plugin-loader": "workspace:^",
    "@qilin/agent": "workspace:^",
    "@qilin/agent-loop": "workspace:^",
    "@qilin/agent-loop-testkit": "workspace:^",
    "@qilin/attachment": "workspace:^",
    "@qilin/attachment-local": "workspace:^",
    "@qilin/browser-use": "workspace:^",
    "@qilin/llm": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/session-projection": "workspace:^",
    "@qilin/system-prompt": "workspace:^",
    "@qilin/tools": "workspace:^",
    "tsx": "^4.19.2"
  }
}
