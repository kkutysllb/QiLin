{
  "name": "@qilin-agent/experimental-client-ui-cot-translation",
  "description": "Optional machine translation of expanded reasoning, preserving original Session text",
  "version": "3.1.4-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/experimental/client-ui-cot-translation"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./types": {
      "types": "./lib/types/types.d.ts"
    }
  },
  "qilin": {
    "client": {
      "inject": [
        "@qilin-agent/api-remotes",
        "@qilin-agent/client-locale",
        "@qilin-agent/client-ui-chat",
        "@qilin-agent/client-ui-plugin-manager",
        "@qilin-agent/client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/typert-protocol": "workspace:*",
    "@qilin-agent/settings": "workspace:*",
    "@qilin-agent/experimental-translator": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/api-session-controller": "workspace:*"
  },
  "dependencies": {
    "@qilin-agent/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/typert-protocol": "workspace:*",
    "@qilin-agent/settings": "workspace:*",
    "@qilin-agent/experimental-translator": "workspace:*",
    "@qilin-agent/api-remotes": "workspace:*",
    "@qilin-agent/client-locale": "workspace:*",
    "@qilin-agent/client-store": "workspace:*",
    "@qilin-agent/client-test-runtime": "workspace:*",
    "@qilin-agent/client-ui-chat": "workspace:*",
    "@qilin-agent/client-ui-plugin-manager": "workspace:*",
    "@qilin-agent/client-ui-primitives": "workspace:*",
    "@qilin-agent/client-ui-renderer": "workspace:*",
    "@qilin-agent/client-ui-settings": "workspace:*",
    "@qilin-agent/client-ui-slots": "workspace:*",
    "@qilin-agent/schemastery": "workspace:~",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@testing-library/react": "^16.3.3",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/api-session-controller": "workspace:*",
    "@qilin-agent/agent-loop-testkit": "workspace:*",
    "@qilin-agent/session-persistence-jsonl": "workspace:*",
    "@qilin-agent/session-query": "workspace:*",
    "@qilin-agent/typert-registry": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
