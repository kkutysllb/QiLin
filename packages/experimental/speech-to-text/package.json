{
  "name": "@qilin/experimental-speech-to-text",
  "description": "Experimental speech recognition with independently selectable providers",
  "version": "3.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/experimental/speech-to-text"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./wave": {
      "types": "./lib/types/wave.d.ts",
      "default": "./lib/types/wave.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@qilin/brand": "workspace:*",
    "@qilin/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@qilin/kylin": "workspace:~",
    "@qilin/settings": "workspace:*",
    "@qilin/kylin-plugin-loader": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@qilin/kylin-plugin-loader": {
      "optional": true
    }
  },
  "devDependencies": {
    "@qilin/kylin": "workspace:~",
    "@qilin/app-boot": "workspace:*",
    "@qilin/settings": "workspace:*",
    "@qilin/kylin-plugin-loader": "workspace:~"
  }
}
