{
  "name": "@qilin-agent/webhook",
  "description": "Fire-and-forget webhook rule runtime that creates Workspace-backed QiLin Sessions",
  "version": "3.1.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/webhook/webhook"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/agent-default-model": "workspace:*",
    "@qilin-agent/agent-presets": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/permission-presets": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/session-title": "workspace:*",
    "@qilin-agent/workspace": "workspace:*"
  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/kylin-plugin-include": "workspace:~",
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/agent-default-model": "workspace:*",
    "@qilin-agent/agent-presets": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/permission-presets": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/session-title": "workspace:*",
    "@qilin-agent/workspace": "workspace:*"
  },
  "dependencies": {
    "@qilin-agent/brand": "workspace:*",
    "@qilin-agent/util-values": "workspace:*"
  }
}
