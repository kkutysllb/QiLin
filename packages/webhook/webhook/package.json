{
  "name": "@qilin/webhook",
  "description": "Fire-and-forget webhook rule runtime that creates Workspace-backed QiLin Sessions",
  "version": "3.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/webhook/webhook"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin/kylin": "workspace:^",
    "@qilin/agent": "workspace:^",
    "@qilin/agent-default-model": "workspace:^",
    "@qilin/agent-presets": "workspace:^",
    "@qilin/invariants": "workspace:^",
    "@qilin/llm": "workspace:^",
    "@qilin/permission-presets": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/session-title": "workspace:^",
    "@qilin/workspace": "workspace:^"
  },
  "devDependencies": {
    "@qilin/kylin": "workspace:^",
    "@qilin/kylin-plugin-include": "workspace:^",
    "@qilin/kylin-plugin-loader": "workspace:^",
    "@qilin/agent": "workspace:^",
    "@qilin/agent-default-model": "workspace:^",
    "@qilin/agent-presets": "workspace:^",
    "@qilin/invariants": "workspace:^",
    "@qilin/llm": "workspace:^",
    "@qilin/permission-presets": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/session-title": "workspace:^",
    "@qilin/workspace": "workspace:^"
  },
  "dependencies": {
    "@qilin/brand": "workspace:^",
    "@qilin/util-values": "workspace:^"
  }
}
