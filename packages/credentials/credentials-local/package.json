{
  "name": "@qilin-agent/credentials-local",
  "description": "File-backed credentials provider ($QILIN_HOME/.env under the live process environment) for the QiLin",
  "version": "3.1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/credentials/credentials-local"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/atomic-write": "workspace:*",
    "@qilin-agent/credentials": "workspace:*",
    "@qilin-agent/launch-environment": "workspace:*",
    "@qilin-agent/home-paths": "workspace:*",
    "@qilin-agent/kylin": "workspace:~"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "@qilin-agent/schemastery": "workspace:~",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@qilin-agent/atomic-write": "workspace:*",
    "@qilin-agent/credentials": "workspace:*",
    "@qilin-agent/launch-environment": "workspace:*",
    "@qilin-agent/home-paths": "workspace:*",
    "@qilin-agent/kylin": "workspace:~"
  }
}
