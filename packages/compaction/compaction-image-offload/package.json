    "@qilin/attachment": "workspace:^",
    "@qilin/compaction": "workspace:^",
    "@qilin/compaction-basic": "workspace:^",
    "@qilin/llm": "workspace:^",
    "@qilin/llm-deepseek": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/session-projection": "workspace:^",
    "@qilin/token-meter": "workspace:^"
  },
