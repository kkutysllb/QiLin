{
  "name": "@qilin-agent/typert-loader",
  "description": "Loader integration for generated Typert package contributions",
  "version": "3.1.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/typert/loader"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/typert-registry": "workspace:*",
    "@qilin-agent/kylin": "workspace:~"
  },
  "dependencies": {
    "@qilin-agent/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/app-boot": "workspace:*",
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/typert-registry": "workspace:*",
    "@qilin-agent/kylin": "workspace:~",
    "zod": "^4.4.3"
  }
}
