{
  "name": "@qilin/fs",
  "description": "Abstract filesystem capability seam (ctx.fs) for the QiLin — vocabulary types, the FileSystem service (text IO + optional version-guarded atomic mutations), and the fs/* policy event vocabulary",
  "version": "3.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/fs/fs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin/brand": "workspace:*",
    "@qilin/llm": "workspace:*",
    "@qilin/sandbox": "workspace:*",
    "@qilin/kylin": "workspace:~"
  },
  "devDependencies": {
    "@qilin/brand": "workspace:*",
    "@qilin/llm": "workspace:*",
    "@qilin/sandbox": "workspace:*",
    "@qilin/kylin": "workspace:~"
  }
}
