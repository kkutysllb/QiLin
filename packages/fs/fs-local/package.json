{
  "name": "@qilin-agent/fs-local",
  "description": "Local-filesystem implementation of the QiLin filesystem seam (ctx.fs)",
  "version": "3.1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/fs/fs-local"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/fs": "workspace:*",
    "@qilin-agent/kylin": "workspace:~"
  },
  "dependencies": {
    "koffi": "3.1.1",
    "@qilin-agent/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/fs": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/kylin": "workspace:~"
  }
}
