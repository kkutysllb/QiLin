{
  "name": "@qilin/fs-sandbox",
  "description": "Sandbox-enforcing implementation of the QiLin filesystem seam: fences write/edit by the per-call sandbox mode (read-only denies mutation, workspace-write contains it to the workspace + temp roots) while reads pass through",
  "version": "3.0.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/fs/fs-sandbox"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin/fs": "workspace:^",
    "@qilin/fs-local": "workspace:^",
    "@qilin/sandbox": "workspace:^",
    "@qilin/sandbox-policy": "workspace:^",
    "@qilin/kylin": "workspace:^"
  },
  "devDependencies": {
    "@qilin/fs": "workspace:^",
    "@qilin/fs-local": "workspace:^",
    "@qilin/sandbox": "workspace:^",
    "@qilin/sandbox-policy": "workspace:^",
    "@qilin/kylin": "workspace:^",
    "@qilin/session-projection": "workspace:^"
  }
}
