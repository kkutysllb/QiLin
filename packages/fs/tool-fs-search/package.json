{
  "name": "@qilin-agent/tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "3.1.4-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/fs/tool-fs-search"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "@qilin-agent/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/output-retention": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/spill": "workspace:*",
    "@qilin-agent/subprocess": "workspace:*",
    "@qilin-agent/system-prompt": "workspace:*",
    "@qilin-agent/timeout": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@qilin-agent/kylin": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/subprocess": "workspace:*",
    "@qilin-agent/subprocess-local": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/output-retention": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/spill": "workspace:*",
    "@qilin-agent/system-prompt": "workspace:*",
    "@qilin-agent/timeout": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/scope": "workspace:*"
  }
}
