{
  "name": "@qilin/sdk-protocol",
  "description": "Shared wire protocol for the QiLin SDK runtime: the newline-delimited JSON-RPC stdio transport and the named request, result, and notification types spoken between the runtime server and SDK clients",
  "version": "3.0.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/sdk/protocol"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin/llm": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/subagent": "workspace:^",
    "@qilin/kylin": "workspace:^"
  },
  "devDependencies": {
    "@qilin/llm": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/subagent": "workspace:^",
    "@qilin/kylin": "workspace:^"
  }
}
