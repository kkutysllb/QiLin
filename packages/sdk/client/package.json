{
  "name": "@qilin-agent/sdk-client",
  "description": "TypeScript client SDK for driving a QiLin runtime subprocess over stdio JSON-RPC: the DeepSeekHarness high-level turns API and the lower-level HarnessClient",
  "version": "3.1.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/sdk/client"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@qilin-agent/cli": "workspace:*"
  },
  "peerDependencies": {
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/sdk-protocol": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/kylin": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/sdk-protocol": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/kylin": "workspace:~"
  }
}
