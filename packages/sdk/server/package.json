{
  "name": "@qilin/sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process QiLin SDK clients",
  "version": "3.0.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/sdk/server"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@qilin/brand": "workspace:^",
    "@qilin/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@qilin/kylin": "workspace:^",
    "@qilin/agent": "workspace:^",
    "@qilin/attachment": "workspace:^",
    "@qilin/llm": "workspace:^",
    "@qilin/llm-deepseek": "workspace:^",
    "@qilin/scope": "workspace:^",
    "@qilin/sdk-protocol": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/subagent": "workspace:^"
  },
  "devDependencies": {
    "@qilin/kylin": "workspace:^",
    "@qilin/kylin-plugin-loader": "workspace:^",
    "@qilin/agent": "workspace:^",
    "@qilin/agent-loop": "workspace:^",
    "@qilin/agent-loop-testkit": "workspace:^",
    "@qilin/attachment": "workspace:^",
    "@qilin/llm": "workspace:^",
    "@qilin/llm-deepseek": "workspace:^",
    "@qilin/scope": "workspace:^",
    "@qilin/sdk-protocol": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/session-persistence-jsonl": "workspace:^",
    "@qilin/session-projection": "workspace:^",
    "@qilin/subagent": "workspace:^"
  }
}
