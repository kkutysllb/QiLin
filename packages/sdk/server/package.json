{
  "name": "@qilin-agent/sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process QiLin SDK clients",
  "version": "3.1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/sdk/server"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@qilin-agent/brand": "workspace:*",
    "@qilin-agent/schemastery": "workspace:~",
    "@qilin-agent/llm-deepseek-api-key": "workspace:*"
  },
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/attachment": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/llm-deepseek": "workspace:*",
    "@qilin-agent/scope": "workspace:*",
    "@qilin-agent/sdk-protocol": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/subagent": "workspace:*"
  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/agent-loop": "workspace:*",
    "@qilin-agent/agent-loop-testkit": "workspace:*",
    "@qilin-agent/attachment": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/llm-deepseek": "workspace:*",
    "@qilin-agent/scope": "workspace:*",
    "@qilin-agent/sdk-protocol": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/session-persistence-jsonl": "workspace:*",
    "@qilin-agent/session-projection": "workspace:*",
    "@qilin-agent/subagent": "workspace:*"
  }
}
