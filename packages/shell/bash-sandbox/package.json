{
  "name": "@qilin/bash-sandbox",
  "description": "Sandbox-consuming implementation of the QiLin bash executor seam (confines every command via ctx.sandbox, reports denial/enforcement result facts)",
  "version": "3.0.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/shell/bash-sandbox"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin/shell": "workspace:^",
    "@qilin/bash-local": "workspace:^",
    "@qilin/sandbox": "workspace:^",
    "@qilin/sandbox-policy": "workspace:^",
    "@qilin/kylin": "workspace:^"
  },
  "devDependencies": {
    "@qilin/shell": "workspace:^",
    "@qilin/bash-local": "workspace:^",
    "@qilin/subprocess-local": "workspace:^",
    "@qilin/sandbox": "workspace:^",
    "@qilin/sandbox-local": "workspace:^",
    "@qilin/sandbox-policy": "workspace:^",
    "@qilin/kylin": "workspace:^",
    "@qilin/node-addon-system": "workspace:^",
    "@qilin/session-projection": "workspace:^"
  }
}
