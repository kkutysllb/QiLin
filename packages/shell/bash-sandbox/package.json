{
  "name": "@qilin-agent/bash-sandbox",
  "description": "Sandbox-consuming implementation of the QiLin bash executor seam (confines every command via ctx.sandbox, reports denial/enforcement result facts)",
  "version": "3.1.4-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/shell/bash-sandbox"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/shell": "workspace:*",
    "@qilin-agent/bash-local": "workspace:*",
    "@qilin-agent/sandbox": "workspace:*",
    "@qilin-agent/sandbox-policy": "workspace:*",
    "@qilin-agent/kylin": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/shell": "workspace:*",
    "@qilin-agent/bash-local": "workspace:*",
    "@qilin-agent/subprocess-local": "workspace:*",
    "@qilin-agent/sandbox": "workspace:*",
    "@qilin-agent/sandbox-local": "workspace:*",
    "@qilin-agent/sandbox-policy": "workspace:*",
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/node-addon-system": "workspace:~",
    "@qilin-agent/session-projection": "workspace:*"
  }
}
