{
  "name": "@qilin-agent/shell-env",
  "description": "Tool-independent managed QILIN_* shell environment registry",
  "version": "3.1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/shell/shell-env"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/shell": "workspace:*",
    "@qilin-agent/home-paths": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@qilin-agent/kylin": "workspace:~"
  },
  "dependencies": {
    "@qilin-agent/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/shell": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/home-paths": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@qilin-agent/kylin": "workspace:~"
  }
}
