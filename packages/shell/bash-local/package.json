{
  "name": "@qilin-agent/bash-local",
  "description": "Local-subprocess implementation of the QiLin bash executor seam",
  "version": "3.1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/shell/bash-local"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/shell": "workspace:*",
    "@qilin-agent/subprocess": "workspace:*",
    "@qilin-agent/timeout": "workspace:*",
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/settings": "workspace:*"
  },
  "dependencies": {
    "@qilin-agent/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/shell": "workspace:*",
    "@qilin-agent/subprocess": "workspace:*",
    "@qilin-agent/subprocess-local": "workspace:*",
    "@qilin-agent/timeout": "workspace:*",
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/settings": "workspace:*"
  }
}
