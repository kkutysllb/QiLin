{
  "name": "@qilin-agent/acp-app",
  "description": "The qilin ACP profile bundle: automation-only JSON-RPC stdio and process lifecycle over qilin-base",
  "version": "3.1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/bundle/acp-app"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "qilin": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@qilin-agent/acp": "workspace:*",
    "@qilin-agent/cmdline": "workspace:*",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/kylin-plugin-include": "workspace:~",
    "@qilin-agent/kylin": "workspace:~"
  }
}
