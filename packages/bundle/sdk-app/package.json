{
  "name": "@qilin-agent/sdk-app",
  "description": "The qilin SDK profile bundle: stdio JSON-RPC serving and process lifecycle over qilin-base",
  "version": "3.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/bundle/sdk-app"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "qilin": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@qilin-agent/cmdline": "workspace:*",
    "@qilin-agent/sdk-jsonrpc-server": "workspace:*",
    "@qilin-agent/schemastery": "workspace:~",
    "commander": "^15.0.0",
    "@qilin-agent/skill-office": "workspace:*",
    "@qilin-agent/tool-workspace-dependencies": "workspace:*"
  },
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/kylin-plugin-include": "workspace:~",
    "@qilin-agent/kylin": "workspace:~"
  }
}
