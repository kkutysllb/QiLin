{
  "publishConfig": {
    "access": "public"
  },
  "version": "3.1.12-rc.3",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~"
  },
  "qilin": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "name": "@qilin-agent/kylin-images-bundle",
  "description": "图像工坊：图像创作、提示词编译与知识漫画（内置 dsh-kylin-images）",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/bundle/kylin-images-bundle"
  },
  "dependencies": {
    "dsh-kylin-images": "^0.1.3"
  }
}
