{
  "name": "@qilin-agent/sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one DeepSeek adapter, persistent shell, and JSONL sessions",
  "version": "3.1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "qilin": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@qilin-agent/kylin-plugin-timer": "workspace:~",
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/agent-loop": "workspace:*",
    "@qilin-agent/deepseek-llm-api-extensions": "workspace:*",
    "@qilin-agent/jobs-local": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/llm-deepseek-api-key": "workspace:*",
    "@qilin-agent/llm-retry": "workspace:*",
    "@qilin-agent/mcp-resources": "workspace:*",
    "@qilin-agent/plugin-package-inventory-deepseek": "workspace:*",
    "@qilin-agent/sandbox-local": "workspace:*",
    "@qilin-agent/sandbox-policy": "workspace:*",
    "@qilin-agent/sdk-app": "workspace:*",
    "@qilin-agent/sdk-jsonrpc-server": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/session-log-deepseek": "workspace:*",
    "@qilin-agent/session-persistence-jsonl": "workspace:*",
    "@qilin-agent/session-projection": "workspace:*",
    "@qilin-agent/session-title": "workspace:*",
    "@qilin-agent/subprocess-local": "workspace:*",
    "@qilin-agent/system-prompt": "workspace:*",
    "@qilin-agent/terminal": "workspace:*",
    "@qilin-agent/terminal-bash": "workspace:*",
    "@qilin-agent/tool-bash-persistent": "workspace:*",
    "@qilin-agent/tool-pwsh-persistent": "workspace:*",
    "@qilin-agent/tools": "workspace:*"
  },
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~"
  }
}
