{
  "name": "@qilin-agent/sandbox-windows-acl",
  "description": "Windows ACL write-restriction sandbox backend (restricted-token spawn with capability-SID write allowlist) for the QiLin sandbox seam",
  "version": "3.1.4-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/sandbox/sandbox-windows-acl"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./runner": {
      "types": "./lib/types/runner.d.ts",
      "default": "./lib/runner.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/runner.js",
    "lib/types-*.js",
    "assets",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/subprocess": "workspace:*",
    "@qilin-agent/skill": "workspace:*"
  },
  "dependencies": {
    "@qilin-agent/lazy-require": "workspace:*",
    "@qilin-agent/win32-process": "workspace:*",
    "koffi": "3.1.1",
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@qilin-agent/pwsh-local": "workspace:*",
    "@qilin-agent/sandbox-local": "workspace:*",
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/subprocess": "workspace:*",
    "@qilin-agent/subprocess-local": "workspace:*",
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/kylin-plugin-include": "workspace:~",
    "@qilin-agent/skill": "workspace:*"
  }
}
