{
  "name": "@qilin-agent/session-log-export",
  "description": "Web Session-log export command and shared download dialog",
  "version": "3.1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/session-query/session-log-export"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@qilin-agent/session-format": "workspace:*",
    "@qilin-agent/schemastery": "workspace:~",
    "fflate": "^0.8.2",
    "@qilin-agent/brand": "workspace:*"
  },
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/session-persistence": "workspace:*"
  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/attachment": "workspace:*",
    "@qilin-agent/client-connection": "workspace:*",
    "@qilin-agent/client-locale": "workspace:*",
    "@qilin-agent/client-store": "workspace:*",
    "@qilin-agent/client-ui-commands": "workspace:*",
    "@qilin-agent/client-ui-conversation": "workspace:*",
    "@qilin-agent/client-ui-primitives": "workspace:*",
    "@qilin-agent/client-ui-renderer": "workspace:*",
    "@qilin-agent/client-ui-session": "workspace:*",
    "@qilin-agent/client-ui-slots": "workspace:*",
    "@qilin-agent/commands": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/session-persistence": "workspace:*",
    "@qilin-agent/session-query": "workspace:*",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "qilin": {
    "client": {
      "inject": [
        "@qilin-agent/client-locale",
        "@qilin-agent/client-ui-commands",
        "@qilin-agent/client-ui-conversation",
        "@qilin-agent/client-ui-renderer",
        "@qilin-agent/client-ui-session"
      ],
      "platform": "web"
    }
  }
}
