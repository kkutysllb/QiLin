{
  "name": "@qilin-agent/tool-workflow",
  "description": "Model-facing workflow tool: run a JavaScript orchestration script over ctx.workflowEngine",
  "version": "3.1.4-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/workflow/tool-workflow"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/system-prompt": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@qilin-agent/workflow": "workspace:*",
    "@qilin-agent/kylin": "workspace:~"
  },
  "dependencies": {
    "@qilin-agent/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/subagent": "workspace:*",
    "@qilin-agent/system-prompt": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@qilin-agent/workflow": "workspace:*",
    "@qilin-agent/workflow-ptc": "workspace:*",
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/session-projection": "workspace:*"
  }
}
