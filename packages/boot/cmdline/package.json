{
  "name": "@qilin/cmdline",
  "description": "Immutable command-line handoff from a qilin launcher to any app plugin that injects cmdlineArgs",
  "version": "3.0.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/boot/cmdline"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin/kylin-plugin-loader": "workspace:^",
    "@qilin/kylin": "workspace:^"
  },
  "devDependencies": {
    "@qilin/kylin-plugin-include": "workspace:^",
    "@qilin/kylin-plugin-loader": "workspace:^",
    "commander": "^15.0.0",
    "@qilin/kylin": "workspace:^"
  }
}
