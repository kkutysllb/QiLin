{
  "name": "@qilin/app-boot",
  "description": "Shared boot glue for the app bins: .env loading, fail-loud Loader guards, snapshot-aware config resolution, and the Loader boot sequence",
  "version": "3.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/boot/app-boot"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@qilin/atomic-write": "workspace:^",
    "@qilin/dsh-compat": "workspace:^",
    "@qilin/package-manifest": "workspace:^",
    "js-yaml": "^4.2.0",
    "resolve.exports": "^2.0.3"
  },
  "peerDependencies": {
    "@qilin/kylin-plugin-group": "workspace:^",
    "@qilin/kylin-plugin-hmr": "workspace:^",
    "@qilin/kylin-plugin-include": "workspace:^",
    "@qilin/kylin-plugin-loader": "workspace:^",
    "@qilin/launch-environment": "workspace:^",
    "@qilin/home-paths": "workspace:^",
    "@qilin/system-prompt": "workspace:^",
    "@qilin/kylin": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@qilin/kylin-plugin-hmr": {
      "optional": true
    }
  },
  "devDependencies": {
    "@qilin/kylin-plugin-group": "workspace:^",
    "@qilin/kylin-plugin-hmr": "workspace:^",
    "@qilin/kylin-plugin-include": "workspace:^",
    "@qilin/kylin-plugin-loader": "workspace:^",
    "@qilin/kylin-plugin-timer": "workspace:^",
    "@qilin/launch-environment": "workspace:^",
    "@qilin/home-paths": "workspace:^",
    "@qilin/system-prompt": "workspace:^",
    "@types/js-yaml": "^4.0.9",
    "@qilin/kylin": "workspace:^",
    "chokidar": "4.0.3"
  }
}
