{
  "name": "@qilin-agent/plugin-manager",
  "description": "Current-profile plugin and bundle management shared by qilin CLI, Web and agent tools",
  "version": "3.1.4-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/boot/plugin-manager"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./registry": {
      "types": "./lib/types/registry.d.ts",
      "default": "./lib/types/registry.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./operations": {
      "types": "./lib/types/operations.d.ts",
      "default": "./lib/types/operations.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/types/tools.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@qilin-agent/app-boot": "workspace:*",
    "@qilin-agent/atomic-write": "workspace:*",
    "@qilin-agent/dsh-compat": "workspace:*",
    "@qilin-agent/schemastery": "workspace:~",
    "execa": "^10.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "@qilin-agent/util-values": "workspace:*"
  },
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/host-plugin-inventory": "workspace:*",
    "@qilin-agent/subprocess": "workspace:*",
    "@qilin-agent/typert-protocol": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@qilin-agent/hmr": "workspace:*",
    "@qilin-agent/brand": "workspace:*",
    "@qilin-agent/sandbox-policy": "workspace:*",
    "@qilin-agent/sandbox": "workspace:*",
    "@qilin-agent/user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@qilin-agent/hmr": {
      "optional": true
    },
    "@qilin-agent/user-approval": {
      "optional": true
    }
  },
  "devDependencies": {
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/brand": "workspace:*",
    "@qilin-agent/hmr": "workspace:*",
    "@qilin-agent/host-plugin-inventory": "workspace:*",
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/kylin-plugin-timer": "workspace:~",
    "@qilin-agent/package-manifest": "workspace:*",
    "@qilin-agent/sandbox": "workspace:*",
    "@qilin-agent/sandbox-policy": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/session-projection": "workspace:*",
    "@qilin-agent/subprocess": "workspace:*",
    "@qilin-agent/system-prompt": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@qilin-agent/typert-protocol": "workspace:*",
    "@qilin-agent/user-approval": "workspace:*"
  }
}
