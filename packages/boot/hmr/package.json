{
  "name": "@qilin-agent/hmr",
  "description": "Coordinated module and profile configuration hot reload",
  "version": "3.1.4-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/boot/hmr"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "author": "Shigma <shigma10826@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/kylin-plugin-timer": "workspace:~",
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/kylin-plugin-include": "workspace:~",
    "@qilin-agent/app-boot": "workspace:*",
    "@qilin-agent/cmdline": "workspace:*"
  },
  "dependencies": {
    "@babel/code-frame": "^7.29.0",
    "chokidar": "^4.0.3",
    "node-addon-require-builtin": "^0.1.9",
    "picomatch": "^4.0.3",
    "@qilin-agent/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@types/babel__code-frame": "^7.27.0",
    "@types/picomatch": "^3.0.2",
    "esbuild": "^0.28.1",
    "@qilin-agent/kylin-plugin-timer": "workspace:~",
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/kylin-plugin-include": "workspace:~",
    "@qilin-agent/app-boot": "workspace:*",
    "@qilin-agent/cmdline": "workspace:*",
    "@qilin-agent/atomic-write": "workspace:*"
  }
}
