{
  "name": "@qilin-agent/plugin-market",
  "description": "Configured plugin market indexes for the Discover page and the plugin_market agent tool",
  "version": "3.1.6-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/boot/plugin-market"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/types/tools.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/worker.cjs",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@qilin-agent/app-boot": "workspace:*",
    "@qilin-agent/package-manifest": "workspace:*",
    "@qilin-agent/plugin-market-index": "workspace:*",
    "@qilin-agent/schemastery": "workspace:~",
    "@qilin-agent/timeout": "workspace:*",
    "@qilin-agent/util-values": "workspace:*",
    "minisearch": "^7.2.0",
    "semver": "^7.8.5",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/plugin-manager": "workspace:*",
    "@qilin-agent/settings": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@qilin-agent/typert-protocol": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@qilin-agent/settings": {
      "optional": true
    }
  },
  "devDependencies": {
    "@qilin-agent/app-boot": "workspace:*",
    "@qilin-agent/cosmokit": "workspace:~",
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/kylin-plugin-include": "workspace:~",
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/plugin-manager": "workspace:*",
    "@qilin-agent/settings": "workspace:*",
    "@qilin-agent/settings-file": "workspace:*",
    "@qilin-agent/system-prompt": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@qilin-agent/typert-protocol": "workspace:*",
    "@types/semver": "^7.8.0"
  }
}
