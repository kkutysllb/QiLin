{
  "name": "@qilin-agent/client-ui-sidebar-terminal",
  "description": "Interactive shell tabs for the right Sidebar",
  "version": "3.1.4-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/client/ui-sidebar-terminal"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "qilin": {
    "client": {
      "inject": [
        "@qilin-agent/api-terminal-controller",
        "@qilin-agent/client-ui-sidebar-right",
        "@qilin-agent/client-ui-sidebar-browser",
        "@qilin-agent/client-ui-settings",
        "@qilin-agent/api-remotes",
        "@qilin-agent/client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/api-remotes": "workspace:*",
    "@qilin-agent/client-locale": "workspace:*",
    "@qilin-agent/client-store": "workspace:*",
    "@qilin-agent/client-test-runtime": "workspace:*",
    "@qilin-agent/client-ui-dockkit": "workspace:*",
    "@qilin-agent/client-ui-primitives": "workspace:*",
    "@qilin-agent/client-ui-renderer": "workspace:*",
    "@qilin-agent/client-ui-session": "workspace:*",
    "@qilin-agent/client-ui-sidebar-browser": "workspace:*",
    "@qilin-agent/client-ui-sidebar-right": "workspace:*",
    "@qilin-agent/client-ui-settings": "workspace:*",
    "@qilin-agent/client-ui-slots": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/settings": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "clsx": "^2.0.0",
    "react-dom": "^18.2.0",
    "@qilin-agent/api-terminal-controller": "workspace:*",
    "@xterm/xterm": "^6.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@qilin-agent/client-ui-layout": "workspace:*",
    "@qilin-agent/client-ui-conversation": "workspace:*",
    "@qilin-agent/client-ui-theme": "workspace:*"
  },
  "dependencies": {
    "@qilin-agent/schemastery": "workspace:~"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.*.js",
    "lib/types/**/*.d.ts"
  ]
}
