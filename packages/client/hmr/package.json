{
  "name": "@qilin/client-hmr",
  "description": "Web client graph synchronization and rebuilt-bundle reload transport",
  "version": "3.0.10",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/client/hmr"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "qilin": {
    "client": {
      "inject": [
        "@qilin/client-modules"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "@qilin/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@qilin/kylin": "workspace:~"
  },
  "devDependencies": {
    "@qilin/kylin-plugin-loader": "workspace:~",
    "@qilin/client-modules": "workspace:*",
    "@qilin/host-webserver": "workspace:*",
    "@qilin/kylin": "workspace:~"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
