{
  "name": "@qilin/client-ui-skill",
  "description": "Web skill references and the dedicated skill tool row",
  "version": "3.0.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/client/ui-skill"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "qilin": {
    "client": {
      "inject": [
        "@qilin/api-session-controller",
        "@qilin/client-locale",
        "@qilin/client-ui-renderer",
        "@qilin/client-ui-tool",
        "@qilin/client-ui-input-trigger",
        "@qilin/api-remotes",
        "@qilin/client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@qilin/kylin": "workspace:^"
  },
  "devDependencies": {
    "@qilin/api-remotes": "workspace:^",
    "@qilin/api-session-controller": "workspace:^",
    "@qilin/client-connection": "workspace:^",
    "@qilin/client-locale": "workspace:^",
    "@qilin/client-test-runtime": "workspace:^",
    "@qilin/client-ui-primitives": "workspace:^",
    "@qilin/client-ui-input-trigger": "workspace:^",
    "@qilin/client-ui-renderer": "workspace:^",
    "@qilin/client-ui-slots": "workspace:^",
    "@qilin/client-ui-tool": "workspace:^",
    "@qilin/session": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@qilin/kylin": "workspace:^",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@qilin/client-ui-sidebar-right": "workspace:^",
    "@qilin/util-workspace-path": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
