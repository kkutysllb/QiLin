{
  "name": "@qilin-agent/client-ui-sidebar-files",
  "description": "Workspace file tree tab type for the right Sidebar: lazy directory listing over the workspaceFiles Remote namespace, opening files into the Sidebar",
  "version": "3.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/client/ui-sidebar-files"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "qilin": {
    "client": {
      "inject": [
        "@qilin-agent/api-workspace-files",
        "@qilin-agent/client-ui-sidebar-right",
        "@qilin-agent/client-ui-session",
        "@qilin-agent/api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@qilin-agent/kylin": "workspace:~",
    "@lezer/highlight": "^1.2.3",
    "@qilin-agent/api-remotes": "workspace:*",
    "@qilin-agent/api-workspace-files": "workspace:*",
    "@qilin-agent/client-locale": "workspace:*",
    "@qilin-agent/client-store": "workspace:*",
    "@qilin-agent/client-test-runtime": "workspace:*",
    "@qilin-agent/client-ui-dockkit": "workspace:*",
    "@qilin-agent/client-ui-primitives": "workspace:*",
    "@qilin-agent/client-ui-renderer": "workspace:*",
    "@qilin-agent/client-ui-sidebar-documentpreview": "workspace:*",
    "@qilin-agent/client-ui-session": "workspace:*",
    "@qilin-agent/client-ui-sidebar-right": "workspace:*",
    "@qilin-agent/client-ui-slots": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/util-workspace-path": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
