{
  "name": "@qilin-agent/client-modules",
  "description": "Client module system, dual-face: node half composes the __QILIN_BOOT__ entry graph (incremental qilin.client scan, bundle route, index tap, webPlugins service); browser half is the lazy-CJS module table the vendored cordis Loader consumes as its internal seam",
  "version": "3.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/client/modules"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "qilin": {
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@qilin-agent/dsh-compat": "workspace:*"
  },
  "devDependencies": {
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/host-webserver": "workspace:*",
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/package-manifest": "workspace:*",
    "@qilin-agent/client-store": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~"
  }
}
