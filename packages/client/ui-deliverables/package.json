{
  "name": "@qilin-agent/client-ui-deliverables",
  "description": "Changed-files card with per-file comparison tabs, delivery cards, and clickable final-response file references for Web",
  "version": "3.1.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/client/ui-deliverables"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "qilin": {
    "client": {
      "inject": [
        "@qilin-agent/api-remotes",
        "@qilin-agent/client-connection",
        "@qilin-agent/client-locale",
        "@qilin-agent/client-ui-chat",
        "@qilin-agent/client-ui-conversation",
        "@qilin-agent/client-ui-renderer",
        "@qilin-agent/client-ui-sidebar-right",
        "@qilin-agent/client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/api-remotes": "workspace:*",
    "@qilin-agent/client-connection": "workspace:*",
    "@qilin-agent/client-locale": "workspace:*",
    "@qilin-agent/client-store": "workspace:*",
    "@qilin-agent/client-test-runtime": "workspace:*",
    "@qilin-agent/client-ui-chat": "workspace:*",
    "@qilin-agent/client-ui-conversation": "workspace:*",
    "@qilin-agent/client-ui-dockkit": "workspace:*",
    "@qilin-agent/client-ui-renderer": "workspace:*",
    "@qilin-agent/client-ui-sidebar-right": "workspace:*",
    "@qilin-agent/client-ui-slots": "workspace:*",
    "@types/react": "~18.3.1",
    "@qilin-agent/kylin": "workspace:~",
    "react": "^18.2.0",
    "@qilin-agent/client-ui-primitives": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/system-prompt": "workspace:*",
    "@qilin-agent/session-query": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/client-ui-tool": "workspace:*",
    "@qilin-agent/tool-present": "workspace:*",
    "@qilin-agent/workspace-changes": "workspace:*",
    "@qilin-agent/api-session-controller": "workspace:*",
    "@qilin-agent/util-workspace-path": "workspace:*",
    "@qilin-agent/api-workspace-files": "workspace:*",
    "@qilin-agent/fs": "workspace:*",
    "@qilin-agent/fs-local": "workspace:*",
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/sandbox-policy": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@qilin-agent/typert-protocol": "workspace:*"
  }
}
