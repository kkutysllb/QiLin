{
  "name": "@qilin/client-web",
  "description": "Web boot kernel: static module table, Cordis loader, framework-free boot page, and UI-renderer handoff",
  "version": "3.0.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/client/web"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./injections": {
      "types": "./lib/types/apply-injections.d.ts",
      "default": "./lib/apply-injections.js"
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@qilin/kylin-plugin-loader": "workspace:^",
    "@qilin/dsh-compat": "workspace:^",
    "@qilin/client-modules": "workspace:^",
    "@qilin/client-store": "workspace:^",
    "@qilin/client-ui-dockkit": "workspace:^",
    "@qilin/client-ui-renderer": "workspace:^",
    "@qilin/client-ui-primitives": "workspace:^",
    "@qilin/client-ui-slots": "workspace:^",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@qilin/kylin": "workspace:^",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.3",
    "@qilin/host-webserver": "workspace:^"
  },
  "peerDependencies": {
    "@qilin/kylin": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/**/*.css",
    "lib/apply-injections.js",
    "lib/types/**/*.d.ts"
  ]
}
