{
  "name": "@qilin/client-ui-settings-user-plugins",
  "description": "User-installed QiLin and DSH plugin management tab for Web Settings",
  "version": "3.0.0",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "https://github.com/deepseek-ai/deepseek-harness.git", "directory": "packages/client/ui-settings-user-plugins" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "qilin": { "client": { "inject": ["@qilin/api-remotes", "@qilin/client-ui-settings", "@qilin/client-locale"], "platform": "web" } },
  "scripts": { "bundle": "tsdown", "watch": "tsdown --watch" },
  "license": "MIT",
  "peerDependencies": { "@qilin/kylin": "workspace:^" },
  "devDependencies": {
    "@qilin/api-remotes": "workspace:^",
    "@qilin/client-locale": "workspace:^",
    "@qilin/client-ui-primitives": "workspace:^",
    "@qilin/client-ui-renderer": "workspace:^",
    "@qilin/client-ui-settings": "workspace:^",
    "@qilin/client-test-runtime": "workspace:^",
    "@qilin/client-ui-slots": "workspace:^",
    "@qilin/kylin": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": ["lib/index.js", "lib/client.js", "lib/types/**/*.d.ts"]
}
