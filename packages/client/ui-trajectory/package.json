{
  "name": "@qilin-agent/client-ui-trajectory",
  "description": "Trajectory event ledger with an interactive timing overview: pure-consumer plugin registering into the conversation ViewMap (no service)",
  "version": "3.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/client/ui-trajectory"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "qilin": {
    "client": {
      "inject": [
        "@qilin-agent/api-session-controller",
        "@qilin-agent/client-locale",
        "@qilin-agent/client-ui-conversation",
        "@qilin-agent/client-ui-renderer",
        "@qilin-agent/client-ui-session",
        "@qilin-agent/client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/client-locale": "workspace:*",
    "@qilin-agent/client-test-runtime": "workspace:*",
    "@qilin-agent/client-ui-primitives": "workspace:*",
    "@qilin-agent/client-ui-conversation": "workspace:*",
    "@qilin-agent/client-ui-slots": "workspace:*",
    "@qilin-agent/compaction": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@qilin-agent/kylin": "workspace:~",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@qilin-agent/client-store": "workspace:*",
    "@qilin-agent/client-ui-chat": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/api-session-controller": "workspace:*",
    "@qilin-agent/client-ui-renderer": "workspace:*",
    "@qilin-agent/client-ui-session": "workspace:*",
    "@qilin-agent/client-ui-sidebar-right": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/attachment": "workspace:*",
    "@tanstack/react-virtual": "^3.14.9",
    "diff": "^9.0.0",
    "@qilin-agent/util-values": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
