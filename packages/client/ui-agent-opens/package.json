{
  "name": "@qilin-agent/client-ui-agent-opens",
  "description": "Opens what the model asked to see in the Session's Sidebar",
  "version": "3.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/client/ui-agent-opens"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "qilin": {
    "client": {
      "inject": [
        "@qilin-agent/api-gateway",
        "@qilin-agent/api-remotes",
        "@qilin-agent/client-ui-sidebar-browser",
        "@qilin-agent/client-ui-sidebar-right",
        "@qilin-agent/client-ui-session"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/api-gateway": "workspace:*",
    "@qilin-agent/api-remotes": "workspace:*",
    "@qilin-agent/client-locale": "workspace:*",
    "@qilin-agent/client-store": "workspace:*",
    "@qilin-agent/client-test-runtime": "workspace:*",
    "@qilin-agent/client-ui-renderer": "workspace:*",
    "@qilin-agent/client-ui-session": "workspace:*",
    "@qilin-agent/client-ui-sidebar-browser": "workspace:*",
    "@qilin-agent/client-ui-sidebar-right": "workspace:*",
    "@qilin-agent/client-ui-slots": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/sidebar-opens": "workspace:*",
    "@qilin-agent/util-workspace-path": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
