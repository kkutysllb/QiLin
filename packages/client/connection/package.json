{
  "name": "@qilin-agent/client-connection",
  "description": "Authenticated RPC transport and generation lifecycle",
  "version": "3.1.4-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/client/connection"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "qilin": {
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "@qilin-agent/credentials": "workspace:*",
    "@qilin-agent/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/scope": "workspace:*"
  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/attachment": "workspace:*",
    "@qilin-agent/brand": "workspace:*",
    "@qilin-agent/host-webserver": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/scope": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/typert-protocol": "workspace:*",
    "@qilin-agent/util-values": "workspace:*",
    "@qilin-agent/tool-todo": "workspace:*",
    "@qilin-agent/commands": "workspace:*",
    "@qilin-agent/host-directory-picker": "workspace:*",
    "@qilin-agent/settings": "workspace:*"
  }
}
