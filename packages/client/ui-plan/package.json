{
  "name": "@qilin/client-ui-plan",
  "description": "Plan mode controls, persistent transcript plan cards, and sidebar Markdown previews",
  "version": "0.1.6-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-plan"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "qilin": {
    "client": {
      "inject": [
        "@qilin/api-remotes",
        "@qilin/client-locale",
        "@qilin/client-ui-conversation",
        "@qilin/client-ui-sidebar-right",
        "@qilin/client-ui-chat",
        "@qilin/client-ui-user-questions",
        "@qilin/client-resources",
        "@qilin/api-session-controller"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@qilin/kylin": "workspace:^"
  },
  "devDependencies": {
    "@qilin/client-store": "workspace:^",
    "@qilin/api-remotes": "workspace:^",
    "@qilin/client-locale": "workspace:^",
    "@qilin/client-test-runtime": "workspace:^",
    "@qilin/client-ui-conversation": "workspace:^",
    "@qilin/client-ui-primitives": "workspace:^",
    "@qilin/client-ui-slots": "workspace:^",
    "@qilin/plan-mode": "workspace:^",
    "@types/react": "~18.3.1",
    "@qilin/kylin": "workspace:^",
    "react": "^18.2.0",
    "@qilin/session": "workspace:^",
    "@qilin/client-ui-renderer": "workspace:^",
    "@qilin/client-ui-session": "workspace:^",
    "@qilin/api-session-controller": "workspace:^",
    "@qilin/client-ui-chat": "workspace:^",
    "@qilin/client-ui-sidebar-right": "workspace:^",
    "@qilin/client-ui-user-questions": "workspace:^",
    "@qilin/client-resources": "workspace:^",
    "@qilin/typert-protocol": "workspace:^",
    "@qilin/llm": "workspace:^",
    "@qilin/tools": "workspace:^",
    "@qilin/util-crypto": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
