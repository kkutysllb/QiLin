{
  "name": "@qilin-agent/client-schema-form",
  "description": "Schema/draft model layer for settings editors: rehydrates a serialized schemastery schema, validates drafts, and edits them immutably by path",
  "version": "3.1.6-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/client/schema-form"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/schemastery": "workspace:~"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ]
}
