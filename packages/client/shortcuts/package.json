{
  "name": "@qilin/client-shortcuts",
  "description": "Application keyboard command registry and physical-key routing",
  "version": "3.0.11",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/client/shortcuts"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./protocol": {
      "types": "./lib/types/protocol.d.ts",
      "default": "./lib/protocol.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/protocol.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "qilin": {
    "client": {
      "inject": [
        "@qilin/client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@qilin/kylin": "workspace:~"
  },
  "devDependencies": {
    "@qilin/kylin": "workspace:~",
    "@qilin/brand": "workspace:*",
    "@qilin/client-locale": "workspace:*",
    "@qilin/client-store": "workspace:*",
    "@qilin/client-test-runtime": "workspace:*",
    "@qilin/client-ui-primitives": "workspace:*",
    "@qilin/host-webserver": "workspace:*"
  },
  "dependencies": {
    "@qilin/schemastery": "workspace:~",
    "@qilin/util-crypto": "workspace:*",
    "@qilin/util-values": "workspace:*"
  }
}
