{
  "name": "@qilin-agent/client-ui-agent-preset",
  "description": "Agent-preset surfaces: the default for later sessions, this session's seat, and the composition editor",
  "version": "3.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/client/ui-agent-preset"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "qilin": {
    "client": {
      "inject": [
        "@qilin-agent/api-session-controller",
        "@qilin-agent/client-connection",
        "@qilin-agent/client-locale",
        "@qilin-agent/client-ui-conversation",
        "@qilin-agent/client-ui-session",
        "@qilin-agent/client-ui-settings",
        "@qilin-agent/client-ui-workspace",
        "@qilin-agent/api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/api-remotes": "workspace:*",
    "@qilin-agent/api-session-controller": "workspace:*",
    "@qilin-agent/agent-presets": "workspace:*",
    "@qilin-agent/client-connection": "workspace:*",
    "@qilin-agent/client-locale": "workspace:*",
    "@qilin-agent/client-store": "workspace:*",
    "@qilin-agent/client-test-runtime": "workspace:*",
    "@qilin-agent/client-ui-conversation": "workspace:*",
    "@qilin-agent/client-ui-plugin-manager": "workspace:*",
    "@qilin-agent/client-ui-primitives": "workspace:*",
    "@qilin-agent/client-ui-settings": "workspace:*",
    "@qilin-agent/client-ui-slots": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/util-values": "workspace:*",
    "@types/react": "~18.3.1",
    "@qilin-agent/kylin": "workspace:~",
    "react": "^18.2.0",
    "@qilin-agent/client-ui-renderer": "workspace:*",
    "@qilin-agent/client-ui-session": "workspace:*",
    "@qilin-agent/client-ui-workspace": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
