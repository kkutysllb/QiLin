{
  "name": "@qilin-agent/client-ui-open-in-app",
  "description": "Web Session-header \"Open In...\" split button opening the session workspace directory in a locally installed application",
  "version": "3.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/client/ui-open-in-app"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "qilin": {
    "client": {
      "inject": [
        "@qilin-agent/client-locale",
        "@qilin-agent/client-shortcuts",
        "@qilin-agent/client-ui-conversation",
        "@qilin-agent/client-ui-layout",
        "@qilin-agent/client-ui-renderer",
        "@qilin-agent/client-ui-session",
        "@qilin-agent/client-ui-sidebar-documentpreview",
        "@qilin-agent/api-remotes",
        "@qilin-agent/api-session-controller"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/api-remotes": "workspace:*",
    "@qilin-agent/api-session-controller": "workspace:*",
    "@qilin-agent/client-locale": "workspace:*",
    "@qilin-agent/client-shortcuts": "workspace:*",
    "@qilin-agent/client-store": "workspace:*",
    "@qilin-agent/client-test-runtime": "workspace:*",
    "@qilin-agent/client-ui-conversation": "workspace:*",
    "@qilin-agent/client-ui-layout": "workspace:*",
    "@qilin-agent/client-ui-primitives": "workspace:*",
    "@qilin-agent/client-ui-renderer": "workspace:*",
    "@qilin-agent/client-ui-session": "workspace:*",
    "@qilin-agent/client-ui-sidebar-documentpreview": "workspace:*",
    "@qilin-agent/client-ui-slots": "workspace:*",
    "@qilin-agent/host-open-in-app": "workspace:*",
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/session": "workspace:*",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "@qilin-agent/client-ui-sidebar-files": "workspace:*"
  }
}
