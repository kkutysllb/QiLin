{
  "name": "@qilin-agent/client-ui-user-questions",
  "description": "Web ask_user_question composer takeover and plan-review presentation UI",
  "version": "3.1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/client/ui-user-questions"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "qilin": {
    "client": {
      "inject": [
        "@qilin-agent/api-remotes",
        "@qilin-agent/api-session-controller",
        "@qilin-agent/client-locale",
        "@qilin-agent/client-ui-conversation",
        "@qilin-agent/client-ui-renderer",
        "@qilin-agent/client-ui-session"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/api-remotes": "workspace:*",
    "@qilin-agent/api-session-controller": "workspace:*",
    "@qilin-agent/client-connection": "workspace:*",
    "@qilin-agent/client-locale": "workspace:*",
    "@qilin-agent/client-store": "workspace:*",
    "@qilin-agent/client-ui-chat": "workspace:*",
    "@qilin-agent/client-ui-conversation": "workspace:*",
    "@qilin-agent/client-ui-primitives": "workspace:*",
    "@qilin-agent/client-ui-renderer": "workspace:*",
    "@qilin-agent/client-ui-session": "workspace:*",
    "@qilin-agent/client-ui-slots": "workspace:*",
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/system-prompt": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@qilin-agent/typert-protocol": "workspace:*",
    "@qilin-agent/user-questions": "workspace:*",
    "@types/react": "~18.3.1",
    "clsx": "^2.0.0",
    "react": "^18.2.0",
    "@qilin-agent/client-ui-tool": "workspace:*",
    "@qilin-agent/brand": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
