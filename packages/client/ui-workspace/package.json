{
  "name": "@qilin-agent/client-ui-workspace",
  "description": "Workspace picker plugin: one WorkspacePicker registered into the sidebar and empty-state workspace slots",
  "version": "3.1.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/client/ui-workspace"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "qilin": {
    "client": {
      "inject": [
        "@qilin-agent/api-remotes",
        "@qilin-agent/api-session-controller",
        "@qilin-agent/api-workspace-controller",
        "@qilin-agent/client-connection",
        "@qilin-agent/client-locale",
        "@qilin-agent/client-shortcuts",
        "@qilin-agent/client-ui-conversation",
        "@qilin-agent/client-ui-layout",
        "@qilin-agent/client-ui-renderer",
        "@qilin-agent/client-ui-session",
        "@qilin-agent/client-ui-sidebar",
        "@qilin-agent/client-ui-workbench"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/api-remotes": "workspace:*",
    "@qilin-agent/api-session-controller": "workspace:*",
    "@qilin-agent/api-workspace-controller": "workspace:*",
    "@qilin-agent/client-connection": "workspace:*",
    "@qilin-agent/client-locale": "workspace:*",
    "@qilin-agent/client-shortcuts": "workspace:*",
    "@qilin-agent/client-store": "workspace:*",
    "@qilin-agent/client-test-runtime": "workspace:*",
    "@qilin-agent/client-ui-conversation": "workspace:*",
    "@qilin-agent/client-ui-layout": "workspace:*",
    "@qilin-agent/client-ui-primitives": "workspace:*",
    "@qilin-agent/client-ui-renderer": "workspace:*",
    "@qilin-agent/client-ui-session": "workspace:*",
    "@qilin-agent/client-ui-sidebar": "workspace:*",
    "@qilin-agent/client-ui-slots": "workspace:*",
    "@qilin-agent/client-ui-workbench": "workspace:*",
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/schedule": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/subagent": "workspace:*",
    "@qilin-agent/typert-protocol": "workspace:*",
    "@qilin-agent/util-workspace-path": "workspace:*",
    "@types/react": "~18.3.1",
    "clsx": "^2.0.0",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
