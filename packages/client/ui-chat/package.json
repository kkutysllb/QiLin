{
  "name": "@qilin-agent/client-ui-chat",
  "description": "Chat Conversation target, node definitions, renderers, and details surface",
  "version": "3.1.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/client/ui-chat"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "qilin": {
    "client": {
      "inject": [
        "@qilin-agent/api-session-controller",
        "@qilin-agent/api-workspace-controller",
        "@qilin-agent/client-locale",
        "@qilin-agent/client-ui-conversation",
        "@qilin-agent/client-ui-trajectory",
        "@qilin-agent/client-ui-layout",
        "@qilin-agent/client-ui-renderer",
        "@qilin-agent/client-ui-session",
        "@qilin-agent/client-ui-sidebar-right",
        "@qilin-agent/client-ui-settings",
        "@qilin-agent/client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/api-remotes": "workspace:*",
    "@qilin-agent/api-session-controller": "workspace:*",
    "@qilin-agent/api-workspace-controller": "workspace:*",
    "@qilin-agent/api-workspace-files": "workspace:*",
    "@qilin-agent/attachment": "workspace:*",
    "@qilin-agent/client-locale": "workspace:*",
    "@qilin-agent/client-store": "workspace:*",
    "@qilin-agent/client-ui-approval": "workspace:*",
    "@qilin-agent/client-ui-conversation": "workspace:*",
    "@qilin-agent/client-ui-layout": "workspace:*",
    "@qilin-agent/client-ui-primitives": "workspace:*",
    "@qilin-agent/client-ui-renderer": "workspace:*",
    "@qilin-agent/client-ui-session": "workspace:*",
    "@qilin-agent/client-ui-settings": "workspace:*",
    "@qilin-agent/client-ui-sidebar-right": "workspace:*",
    "@qilin-agent/client-ui-sidebar-browser": "workspace:*",
    "@qilin-agent/client-ui-sidebar-documentpreview": "workspace:*",
    "@qilin-agent/client-ui-trajectory": "workspace:*",
    "@qilin-agent/client-ui-slots": "workspace:*",
    "@qilin-agent/client-ui-workspace": "workspace:*",
    "@qilin-agent/commands": "workspace:*",
    "@qilin-agent/compaction": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/llm-retry": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/session-stats": "workspace:*",
    "@qilin-agent/session-turn-outline": "workspace:*",
    "@qilin-agent/settings": "workspace:*",
    "@qilin-agent/subagent": "workspace:*",
    "@qilin-agent/token-meter": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@qilin-agent/util-workspace-path": "workspace:*",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@qilin-agent/client-ui-input-trigger": "workspace:*",
    "@qilin-agent/util-values": "workspace:*",
    "@qilin-agent/brand": "workspace:*",
    "@tanstack/react-virtual": "^3.14.9"
  },
  "dependencies": {
    "@qilin-agent/schemastery": "workspace:~"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
