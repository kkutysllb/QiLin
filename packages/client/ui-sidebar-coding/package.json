{
  "name": "@qilin/client-ui-sidebar-coding",
  "description": "Coding workbench content body for the right Sidebar (dual workbench D5): the VSCode-like workbench — explorer/editor/terminal/git/browser tabs, per-session isolated, with lazy preview chunks. Ported from dsh-coding-sidebar 1.0.39",
  "version": "3.1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/client/ui-sidebar-coding"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "qilin": {
    "client": {
      "inject": [
        "@qilin/agent",
        "@qilin/api-remotes",
        "@qilin/api-session-controller",
        "@qilin/client-locale",
        "@qilin/client-modules",
        "@qilin/client-ui-conversation",
        "@qilin/client-ui-primitives",
        "@qilin/client-ui-settings",
        "@qilin/client-ui-slots",
        "@qilin/client-ui-workbench",
        "@qilin/llm",
        "@qilin/session",
        "@qilin/subagent",
        "@qilin/tools"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@qilin/kylin": "workspace:~"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "@qilin/tools": "workspace:*",
    "@qilin/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@aiden0z/pptx-renderer": "1.2.4",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.3",
    "@qilin/agent": "workspace:*",
    "@qilin/api-remotes": "workspace:*",
    "@qilin/api-session-controller": "workspace:*",
    "@qilin/client-connection": "workspace:*",
    "@qilin/client-locale": "workspace:*",
    "@qilin/client-modules": "workspace:*",
    "@qilin/client-store": "workspace:*",
    "@qilin/client-ui-conversation": "workspace:*",
    "@qilin/client-ui-primitives": "workspace:*",
    "@qilin/client-ui-session": "workspace:*",
    "@qilin/client-ui-settings": "workspace:*",
    "@qilin/client-ui-slots": "workspace:*",
    "@qilin/client-ui-workbench": "workspace:*",
    "@qilin/host-webserver": "workspace:*",
    "@qilin/kylin": "workspace:~",
    "@qilin/llm": "workspace:*",
    "@qilin/session": "workspace:*",
    "@qilin/settings": "workspace:*",
    "@qilin/subagent": "workspace:*",
    "@qilin/util-crypto": "workspace:*",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@univerjs/preset-sheets-core": "0.25.1",
    "@univerjs/presets": "0.25.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "docx-preview": "0.4.0",
    "dompurify": "^3.4.14",
    "lightningcss": "^1.29.0",
    "mermaid": "11.17.2",
    "node-pty": "1.2.0-beta.15",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "5.7.0",
    "rxjs": "^7.8.2",
    "tsdown": "^0.14.0",
    "xlsx": "0.18.5"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.*.js",
    "lib/types/**/*.d.ts"
  ]
}
