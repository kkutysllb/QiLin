{
  "name": "@qilin/client-ui-sidebar-tasks",
  "description": "Subagent topology and background-job tab type for the right Sidebar: this Session's direct-child catalog, the descendant totals its summary lineage records, and its live job list",
  "version": "3.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-sidebar-tasks"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "qilin": {
    "client": {
      "inject": [
        "@qilin/api-session-controller",
        "@qilin/client-ui-primitives",
        "@qilin/client-ui-session",
        "@qilin/client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@qilin/api-remotes": "workspace:^",
    "@qilin/api-session-controller": "workspace:^",
    "@qilin/client-locale": "workspace:^",
    "@qilin/client-test-runtime": "workspace:^",
    "@qilin/client-ui-primitives": "workspace:^",
    "@qilin/client-ui-renderer": "workspace:^",
    "@qilin/client-ui-session": "workspace:^",
    "@qilin/client-ui-sidebar-right": "workspace:^",
    "@qilin/client-ui-slots": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/subagent": "workspace:^",
    "@qilin/typert-protocol": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
