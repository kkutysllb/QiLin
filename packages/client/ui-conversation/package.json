{
  "name": "@qilin/client-ui-conversation",
  "description": "Target-neutral Conversation assembly, shell, composer, queue, and view navigation",
  "version": "3.0.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/client/ui-conversation"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "qilin": {
    "client": {
      "inject": [
        "@qilin/api-session-controller",
        "@qilin/client-file-upload",
        "@qilin/client-locale",
        "@qilin/client-shortcuts",
        "@qilin/client-ui-layout",
        "@qilin/client-ui-renderer",
        "@qilin/client-ui-session",
        "@qilin/client-ui-settings",
        "@qilin/client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@qilin/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@qilin/kylin": "workspace:~"
  },
  "devDependencies": {
    "@lexical/headless": "^0.49.0",
    "@lexical/history": "^0.49.0",
    "@lexical/plain-text": "^0.49.0",
    "@lexical/text": "^0.49.0",
    "@lexical/utils": "^0.49.0",
    "@qilin/agent": "workspace:*",
    "@qilin/api-remotes": "workspace:*",
    "@qilin/api-session-controller": "workspace:*",
    "@qilin/api-workspace-controller": "workspace:*",
    "@qilin/attachment": "workspace:*",
    "@qilin/brand": "workspace:*",
    "@qilin/client-file-upload": "workspace:*",
    "@qilin/client-locale": "workspace:*",
    "@qilin/client-shortcuts": "workspace:*",
    "@qilin/client-store": "workspace:*",
    "@qilin/client-test-runtime": "workspace:*",
    "@qilin/client-ui-layout": "workspace:*",
    "@qilin/client-ui-primitives": "workspace:*",
    "@qilin/client-ui-renderer": "workspace:*",
    "@qilin/client-ui-session": "workspace:*",
    "@qilin/client-ui-settings": "workspace:*",
    "@qilin/client-ui-slots": "workspace:*",
    "@qilin/client-ui-workspace": "workspace:*",
    "@qilin/commands": "workspace:*",
    "@qilin/goal": "workspace:*",
    "@qilin/kylin": "workspace:~",
    "@qilin/llm": "workspace:*",
    "@qilin/llm-retry": "workspace:*",
    "@qilin/plan-mode": "workspace:*",
    "@qilin/session": "workspace:*",
    "@qilin/settings": "workspace:*",
    "@qilin/token-meter": "workspace:*",
    "@qilin/tool-todo": "workspace:*",
    "@qilin/util-crypto": "workspace:*",
    "@qilin/util-values": "workspace:*",
    "@qilin/util-workspace-path": "workspace:*",
    "@qilin/workspace": "workspace:*",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "^2.0.0",
    "lexical": "^0.49.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^4.4.3"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
