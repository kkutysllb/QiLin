{
  "name": "@qilin-agent/client-ui-conversation",
  "description": "Target-neutral Conversation assembly, shell, composer, queue, and view navigation",
  "version": "3.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/client/ui-conversation"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "qilin": {
    "client": {
      "inject": [
        "@qilin-agent/api-session-controller",
        "@qilin-agent/client-file-upload",
        "@qilin-agent/client-locale",
        "@qilin-agent/client-shortcuts",
        "@qilin-agent/client-ui-layout",
        "@qilin-agent/client-ui-renderer",
        "@qilin-agent/client-ui-session",
        "@qilin-agent/client-ui-settings",
        "@qilin-agent/client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@qilin-agent/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~"
  },
  "devDependencies": {
    "@lexical/headless": "^0.49.0",
    "@lexical/history": "^0.49.0",
    "@lexical/plain-text": "^0.49.0",
    "@lexical/text": "^0.49.0",
    "@lexical/utils": "^0.49.0",
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/api-remotes": "workspace:*",
    "@qilin-agent/api-session-controller": "workspace:*",
    "@qilin-agent/api-workspace-controller": "workspace:*",
    "@qilin-agent/attachment": "workspace:*",
    "@qilin-agent/brand": "workspace:*",
    "@qilin-agent/client-file-upload": "workspace:*",
    "@qilin-agent/client-locale": "workspace:*",
    "@qilin-agent/client-shortcuts": "workspace:*",
    "@qilin-agent/client-store": "workspace:*",
    "@qilin-agent/client-test-runtime": "workspace:*",
    "@qilin-agent/client-ui-layout": "workspace:*",
    "@qilin-agent/client-ui-primitives": "workspace:*",
    "@qilin-agent/client-ui-renderer": "workspace:*",
    "@qilin-agent/client-ui-session": "workspace:*",
    "@qilin-agent/client-ui-settings": "workspace:*",
    "@qilin-agent/client-ui-slots": "workspace:*",
    "@qilin-agent/client-ui-workspace": "workspace:*",
    "@qilin-agent/commands": "workspace:*",
    "@qilin-agent/goal": "workspace:*",
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/llm-retry": "workspace:*",
    "@qilin-agent/plan-mode": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/settings": "workspace:*",
    "@qilin-agent/token-meter": "workspace:*",
    "@qilin-agent/tool-todo": "workspace:*",
    "@qilin-agent/util-crypto": "workspace:*",
    "@qilin-agent/util-values": "workspace:*",
    "@qilin-agent/util-workspace-path": "workspace:*",
    "@qilin-agent/workspace": "workspace:*",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "^2.0.0",
    "lexical": "^0.49.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^4.4.3"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
