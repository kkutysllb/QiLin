{
  "name": "@qilin-agent/ptc-runtime-node",
  "description": "Node PTC execution with per-call sandboxed processes or in-memory REPL state",
  "version": "3.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/ptc-runtime/ptc-runtime-node"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./process": {
      "types": "./lib/types/process-entry.d.ts",
      "default": "./lib/process.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/process.js",
    "lib/persistent-process.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/ptc-runtime": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/timeout": "workspace:*",
    "@qilin-agent/fs": "workspace:*",
    "@qilin-agent/subprocess": "workspace:*",
    "@qilin-agent/sandbox": "workspace:*",
    "@qilin-agent/sandbox-policy": "workspace:*"
  },
  "dependencies": {
    "@qilin-agent/util-values": "workspace:*",
    "@qilin-agent/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/ptc-runtime": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/timeout": "workspace:*",
    "@qilin-agent/fs": "workspace:*",
    "@qilin-agent/subprocess": "workspace:*",
    "@qilin-agent/sandbox": "workspace:*",
    "@qilin-agent/sandbox-policy": "workspace:*",
    "@qilin-agent/fs-local": "workspace:*",
    "@qilin-agent/subprocess-local": "workspace:*",
    "@qilin-agent/session-projection": "workspace:*",
    "@qilin-agent/sandbox-local": "workspace:*"
  }
}
