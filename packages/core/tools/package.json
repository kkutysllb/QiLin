{
  "name": "@qilin-agent/tools",
  "description": "Tool registry and execution pipeline for the QiLin",
  "version": "3.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/core/tools"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./presentation": {
      "types": "./lib/types/presentation.d.ts",
      "default": "./lib/types/presentation.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/ptc-runtime": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/scope": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/system-prompt": "workspace:*",
    "@qilin-agent/user-approval": "workspace:*",
    "@qilin-agent/sandbox": "workspace:*",
    "@qilin-agent/sandbox-policy": "workspace:*"
  },
  "dependencies": {
    "@qilin-agent/brand": "workspace:*",
    "@qilin-agent/util-values": "workspace:*",
    "@qilin-agent/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/ptc-runtime": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/scope": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/session-projection": "workspace:*",
    "@qilin-agent/system-prompt": "workspace:*",
    "@qilin-agent/user-approval": "workspace:*",
    "@qilin-agent/sandbox": "workspace:*",
    "@qilin-agent/sandbox-policy": "workspace:*"
  }
}
