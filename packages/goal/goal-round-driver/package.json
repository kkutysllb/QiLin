{
  "name": "@qilin/goal-round-driver",
  "description": "Race-fenced same-session goal-round driver",
  "version": "3.0.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/goal/goal-round-driver"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin/agent": "workspace:^",
    "@qilin/goal": "workspace:^",
    "@qilin/invariants": "workspace:^",
    "@qilin/llm": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/kylin": "workspace:^"
  },
  "devDependencies": {
    "@qilin/agent": "workspace:^",
    "@qilin/agent-loop": "workspace:^",
    "@qilin/agent-loop-testkit": "workspace:^",
    "@qilin/goal": "workspace:^",
    "@qilin/invariants": "workspace:^",
    "@qilin/llm": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/system-prompt": "workspace:^",
    "@qilin/tools": "workspace:^",
    "@qilin/kylin": "workspace:^",
    "@qilin/session-projection": "workspace:^"
  }
}
