{
  "name": "@qilin-agent/session-reference",
  "description": "Cross-session snapshot references and durable untrusted model context (ctx.sessionReferenceResolver)",
  "version": "3.1.4-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/context/session-reference"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@qilin-agent/brand": "workspace:*",
    "@qilin-agent/util-values": "workspace:*",
    "@qilin-agent/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/compaction": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/output-retention": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/session-projection": "workspace:*",
    "@qilin-agent/session-projection-cache": "workspace:*",
    "@qilin-agent/session-query": "workspace:*",
    "@qilin-agent/session-title": "workspace:*",
    "@qilin-agent/spill": "workspace:*",
    "@qilin-agent/subagent": "workspace:*",
    "@qilin-agent/system-prompt": "workspace:*",
    "@qilin-agent/typert-protocol": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@qilin-agent/spill": {
      "optional": true
    },
    "@qilin-agent/session-projection-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/kylin-plugin-include": "workspace:~",
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/compaction": "workspace:*",
    "@qilin-agent/fs-local": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/output-retention": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/session-projection": "workspace:*",
    "@qilin-agent/session-projection-cache": "workspace:*",
    "@qilin-agent/session-query": "workspace:*",
    "@qilin-agent/session-query-sqlite": "workspace:*",
    "@qilin-agent/session-title": "workspace:*",
    "@qilin-agent/spill": "workspace:*",
    "@qilin-agent/subagent": "workspace:*",
    "@qilin-agent/spill-local": "workspace:*",
    "@qilin-agent/system-prompt": "workspace:*",
    "@qilin-agent/tool-fs": "workspace:*",
    "@qilin-agent/tools": "workspace:*",
    "@qilin-agent/typert-protocol": "workspace:*"
  }
}
