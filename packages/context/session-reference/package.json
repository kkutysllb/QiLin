{
  "name": "@qilin/session-reference",
  "description": "Cross-session snapshot references and durable untrusted model context (ctx.sessionReferenceResolver)",
  "version": "3.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/context/session-reference"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@qilin/brand": "workspace:^",
    "@qilin/util-values": "workspace:^",
    "@qilin/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@qilin/kylin": "workspace:^",
    "@qilin/agent": "workspace:^",
    "@qilin/compaction": "workspace:^",
    "@qilin/llm": "workspace:^",
    "@qilin/output-retention": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/session-projection": "workspace:^",
    "@qilin/session-projection-cache": "workspace:^",
    "@qilin/session-query": "workspace:^",
    "@qilin/session-title": "workspace:^",
    "@qilin/spill": "workspace:^",
    "@qilin/subagent": "workspace:^",
    "@qilin/system-prompt": "workspace:^",
    "@qilin/typert-protocol": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@qilin/spill": {
      "optional": true
    },
    "@qilin/session-projection-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "@qilin/kylin": "workspace:^",
    "@qilin/kylin-plugin-include": "workspace:^",
    "@qilin/kylin-plugin-loader": "workspace:^",
    "@qilin/agent": "workspace:^",
    "@qilin/compaction": "workspace:^",
    "@qilin/fs-local": "workspace:^",
    "@qilin/llm": "workspace:^",
    "@qilin/output-retention": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/session-projection": "workspace:^",
    "@qilin/session-projection-cache": "workspace:^",
    "@qilin/session-query": "workspace:^",
    "@qilin/session-query-sqlite": "workspace:^",
    "@qilin/session-title": "workspace:^",
    "@qilin/spill": "workspace:^",
    "@qilin/subagent": "workspace:^",
    "@qilin/spill-local": "workspace:^",
    "@qilin/system-prompt": "workspace:^",
    "@qilin/tool-fs": "workspace:^",
    "@qilin/tools": "workspace:^",
    "@qilin/typert-protocol": "workspace:^"
  }
}
