{
  "name": "@qilin-agent/user-questions",
  "description": "Abstract user-questions seam (ctx.userQuestions) for asking the human during agent runs",
  "version": "3.1.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/interaction/user-questions"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/scope": "workspace:*",
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/typert-protocol": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/session-projection": "workspace:*"
  },
  "devDependencies": {
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/scope": "workspace:*",
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/typert-protocol": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/session-projection": "workspace:*",
    "@qilin-agent/session-persistence-jsonl": "workspace:*",
    "@qilin-agent/tools": "workspace:*"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@qilin-agent/schemastery": "workspace:~"
  }
}
