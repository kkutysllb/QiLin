{
  "name": "@qilin-agent/user-approval",
  "description": "User-approval seam (ctx.approval) for the QiLin: one-shot permission decisions dispatched to composed answerers over the approval/request waterfall, fail-closed by default",
  "version": "3.1.4-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/interaction/user-approval"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/brand": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/scope": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/system-prompt": "workspace:*",
    "@qilin-agent/kylin": "workspace:~"
  },
  "dependencies": {
    "@qilin-agent/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/brand": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/scope": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/system-prompt": "workspace:*",
    "@qilin-agent/kylin": "workspace:~"
  }
}
