{
  "name": "@qilin/acp",
  "description": "Automation-only Agent Client Protocol server for driving QiLin agents over JSON-RPC stdio",
  "version": "3.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@qilin/brand": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@qilin/kylin": "workspace:^",
    "@qilin/agent": "workspace:^",
    "@qilin/attachment": "workspace:^",
    "@qilin/llm": "workspace:^",
    "@qilin/mcp-client": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/session-persistence": "workspace:^",
    "@qilin/token-meter": "workspace:^",
    "@qilin/user-approval": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@qilin/token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@qilin/kylin": "workspace:^",
    "@qilin/agent": "workspace:^",
    "@qilin/agent-loop": "workspace:^",
    "@qilin/agent-loop-testkit": "workspace:^",
    "@qilin/attachment": "workspace:^",
    "@qilin/llm": "workspace:^",
    "@qilin/mcp-client": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/session-persistence": "workspace:^",
    "@qilin/session-persistence-jsonl": "workspace:^",
    "@qilin/session-projection": "workspace:^",
    "@qilin/token-meter": "workspace:^",
    "@qilin/tools": "workspace:^",
    "@qilin/user-approval": "workspace:^"
  }
}
