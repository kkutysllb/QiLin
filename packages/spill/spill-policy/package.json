{
  "name": "@qilin/spill-policy",
  "description": "Token-budgeted tool-result retention with recoverable text and image paths",
  "version": "3.0.11",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/spill/spill-policy"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./notice": {
      "types": "./lib/types/notice.d.ts",
      "default": "./lib/types/notice.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin/llm": "workspace:*",
    "@qilin/output-retention": "workspace:*",
    "@qilin/session": "workspace:*",
    "@qilin/spill": "workspace:*",
    "@qilin/tools": "workspace:*",
    "@qilin/kylin": "workspace:~",
    "@qilin/attachment": "workspace:*",
    "@qilin/fs": "workspace:*",
    "@qilin/token-meter": "workspace:*"
  },
  "dependencies": {
    "@qilin/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@qilin/agent": "workspace:*",
    "@qilin/ptc-runtime-node": "workspace:*",
    "@qilin/llm": "workspace:*",
    "@qilin/output-retention": "workspace:*",
    "@qilin/session": "workspace:*",
    "@qilin/spill": "workspace:*",
    "@qilin/tools": "workspace:*",
    "@qilin/kylin": "workspace:~",
    "@qilin/fs-local": "workspace:*",
    "@qilin/subprocess-local": "workspace:*",
    "@qilin/sandbox-local": "workspace:*",
    "@qilin/sandbox-policy": "workspace:*",
    "@qilin/session-projection": "workspace:*",
    "@qilin/attachment": "workspace:*",
    "@qilin/fs": "workspace:*",
    "@qilin/token-meter": "workspace:*",
    "@qilin/mcp-client": "workspace:*",
    "@qilin/spill-local": "workspace:*",
    "@qilin/llm-deepseek": "workspace:*",
    "@qilin/ptc-runtime": "workspace:*",
    "@qilin/attachment-local": "workspace:*",
    "@qilin/tool-fs": "workspace:*",
    "sharp": "^0.35.3"
  }
