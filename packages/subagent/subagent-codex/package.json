{
  "name": "@qilin-agent/subagent-codex",
  "description": "One-shot Codex subagent provider over the official app-server protocol",
  "version": "3.1.7-rc.1",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/subagent/subagent-codex"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "qilin": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@openai/codex": "0.153.4",
    "@qilin-agent/brand": "workspace:*",
    "@qilin-agent/schemastery": "workspace:~",
    "@qilin-agent/sdk-protocol": "workspace:*",
    "@qilin-agent/tool-subagent": "workspace:*"
  },
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/subagent": "workspace:*",
    "@qilin-agent/subprocess": "workspace:*",
    "@qilin-agent/timeout": "workspace:*"
  },
  "devDependencies": {
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/app-boot": "workspace:*",
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/loader-smoke": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/session-checkpoint-policy": "workspace:*",
    "@qilin-agent/session-persistence-jsonl": "workspace:*",
    "@qilin-agent/session-projection": "workspace:*",
    "@qilin-agent/subagent": "workspace:*",
    "@qilin-agent/subprocess": "workspace:*",
    "@qilin-agent/subprocess-local": "workspace:*",
    "@qilin-agent/timeout": "workspace:*",
    "@qilin-agent/tool-jobs": "workspace:*",
    "@qilin-agent/tools": "workspace:*"
  }
}
