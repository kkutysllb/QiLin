{
  "name": "@qilin/subagent-codex",
  "description": "One-shot Codex subagent provider over the official app-server protocol",
  "version": "3.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/subagent/subagent-codex"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "qilin": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@qilin/kylin": "workspace:^",
    "@qilin/llm": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/subagent": "workspace:^",
    "@qilin/subprocess": "workspace:^",
    "@qilin/timeout": "workspace:^"
  },
  "dependencies": {
    "@qilin/brand": "workspace:^",
    "@qilin/sdk-protocol": "workspace:^",
    "@qilin/schemastery": "workspace:^",
    "@openai/codex": "0.153.4"
  },
  "devDependencies": {
    "@qilin/kylin": "workspace:^",
    "@qilin/kylin-plugin-loader": "workspace:^",
    "@qilin/agent": "workspace:^",
    "@qilin/app-boot": "workspace:^",
    "@qilin/llm": "workspace:^",
    "@qilin/loader-smoke": "workspace:^",
    "@qilin/session": "workspace:^",
    "@qilin/session-checkpoint-policy": "workspace:^",
    "@qilin/session-persistence-jsonl": "workspace:^",
    "@qilin/session-projection": "workspace:^",
    "@qilin/subagent": "workspace:^",
    "@qilin/subprocess": "workspace:^",
    "@qilin/subprocess-local": "workspace:^",
    "@qilin/timeout": "workspace:^",
    "@qilin/tool-jobs": "workspace:^",
    "@qilin/tool-subagent": "workspace:^",
    "@qilin/tools": "workspace:^"
  }
}
