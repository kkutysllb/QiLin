{
  "name": "@qilin-agent/subagent-qilin-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child QiLin runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "3.1.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/subagent/subagent-qilin-sdk"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/sdk-client": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/subagent": "workspace:*",
    "@qilin-agent/subprocess": "workspace:*"
  },
  "dependencies": {
    "@qilin-agent/brand": "workspace:*",
    "@qilin-agent/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/agent-instructions": "workspace:*",
    "@qilin-agent/app-boot": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/llm-deepseek": "workspace:*",
    "@qilin-agent/loader-smoke": "workspace:*",
    "@qilin-agent/sdk-client": "workspace:*",
    "@qilin-agent/sdk-protocol": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/session-checkpoint-policy": "workspace:*",
    "@qilin-agent/session-persistence-jsonl": "workspace:*",
    "@qilin-agent/session-projection": "workspace:*",
    "@qilin-agent/skill-filesystem": "workspace:*",
    "@qilin-agent/subagent": "workspace:*",
    "@qilin-agent/subprocess": "workspace:*",
    "@qilin-agent/system-prompt": "workspace:*",
    "@qilin-agent/tool-subagent": "workspace:*"
  }
}
