{
  "name": "@qilin-agent/api-settings-controller",
  "description": "Remote owner for the configuration surfaces over the settings-domain seams",
  "version": "3.1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/api/settings-controller"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@qilin-agent/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/agent-presets": "workspace:*",
    "@qilin-agent/credentials": "workspace:*",
    "@qilin-agent/native-command": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/settings": "workspace:*",
    "@qilin-agent/typert-protocol": "workspace:*"
  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/agent-presets": "workspace:*",
    "@qilin-agent/credentials": "workspace:*",
    "@qilin-agent/native-command": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/settings": "workspace:*",
    "@qilin-agent/typert-protocol": "workspace:*"
  }
}
