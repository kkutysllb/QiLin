{
  "name": "@qilin-agent/client-product-analytics",
  "description": "Desktop product event collection and authenticated Host reporting",
  "version": "3.1.8-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/api/product-analytics"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/events.d.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~"
  },
  "devDependencies": {
    "@qilin-agent/api-gateway": "workspace:*",
    "@qilin-agent/app-boot": "workspace:*",
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/kylin-plugin-loader": "workspace:~",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/typert-protocol": "workspace:*"
  },
  "dependencies": {},
  "optionalDependencies": {},
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "qilin": {
    "client": {
      "inject": [
        "@qilin-agent/api-gateway"
      ],
      "platform": "web"
    }
  }
}
