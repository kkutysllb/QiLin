{
  "name": "@qilin-agent/api-workspace-controller",
  "description": "Workspace Remote commands and reconnect-safe state transport",
  "version": "3.1.4-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/api/workspace-controller"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "qilin": {
    "client": {
      "external": [
        "@qilin-agent/api-gateway/client"
      ],
      "inject": [
        "@qilin-agent/api-gateway",
        "@qilin-agent/client-connection"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@qilin-agent/deque": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/api-gateway": "workspace:*",
    "@qilin-agent/client-connection": "workspace:*",
    "@qilin-agent/host-directory-picker": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/storage-domain": "workspace:*",
    "@qilin-agent/typert-protocol": "workspace:*",
    "@qilin-agent/workspace": "workspace:*"
  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/api-gateway": "workspace:*",
    "@qilin-agent/client-connection": "workspace:*",
    "@qilin-agent/client-store": "workspace:*",
    "@qilin-agent/client-test-runtime": "workspace:*",
    "@qilin-agent/host-directory-picker": "workspace:*",
    "@qilin-agent/remote-mock": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/storage-domain": "workspace:*",
    "@qilin-agent/typert-protocol": "workspace:*",
    "@qilin-agent/workspace": "workspace:*"
  }
}
