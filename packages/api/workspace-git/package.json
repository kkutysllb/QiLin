{
  "name": "@qilin/api-workspace-git",
  "description": "Host owner of the workspaceGit Remote namespace: repository discovery, porcelain status, staging, commits, branches, and push/pull inside the session workspace root",
  "version": "3.0.10",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/api/workspace-git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "dependencies": {
    "@qilin/schemastery": "workspace:~",
    "@qilin/typert-protocol": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@qilin/kylin": "workspace:~"
  },
  "devDependencies": {
    "@qilin/kylin": "workspace:~",
    "@qilin/api-workspace-files": "workspace:*",
    "@qilin/session": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ]
}
