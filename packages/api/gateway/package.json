{
  "name": "@qilin/api-gateway",
  "description": "Typert Remote Host dispatcher and Client API endpoint",
  "version": "3.0.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/api/gateway"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "qilin": {
    "client": {
      "inject": [
        "@qilin/typert-registry",
        "@qilin/client-connection"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@qilin/deque": "workspace:^",
    "@qilin/timeout": "workspace:^",
    "@qilin/schemastery": "workspace:^",
    "ws": "^8.21.0",
    "@qilin/typert-protocol": "workspace:^"
  },
  "peerDependencies": {
    "@qilin/kylin": "workspace:^"
  },
  "devDependencies": {
    "@qilin/brand": "workspace:^",
    "@qilin/client-connection": "workspace:^",
    "@qilin/host-webserver": "workspace:^",
    "@qilin/remote-mock": "workspace:^",
    "@qilin/typert-registry": "workspace:^",
    "@qilin/util-crypto": "workspace:^",
    "@types/ws": "^8.18.1",
    "@qilin/kylin": "workspace:^",
    "zod": "^4.4.3"
  }
}
