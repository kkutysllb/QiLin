{
  "name": "@qilin-agent/api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "3.1.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/api/remotes"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "qilin": {
    "client": {
      "inject": [
        "@qilin-agent/api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@qilin-agent/deque": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/util-values": "workspace:*"
  },
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/scope": "workspace:*"
  },
  "devDependencies": {
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/agent-presets": "workspace:*",
    "@qilin-agent/api-gateway": "workspace:*",
    "@qilin-agent/api-session-controller": "workspace:*",
    "@qilin-agent/api-settings-controller": "workspace:*",
    "@qilin-agent/api-job-controller": "workspace:*",
    "@qilin-agent/api-terminal-controller": "workspace:*",
    "@qilin-agent/api-workspace-controller": "workspace:*",
    "@qilin-agent/api-workspace-files": "workspace:*",
    "@qilin-agent/api-workspace-git": "workspace:*",
    "@qilin-agent/client-connection": "workspace:*",
    "@qilin-agent/client-file-upload": "workspace:*",
    "@qilin-agent/client-ui-plugin-manager": "workspace:*",
    "@qilin-agent/command-feedback": "workspace:*",
    "@qilin-agent/commands": "workspace:*",
    "@qilin-agent/credentials": "workspace:*",
    "@qilin-agent/file-reference": "workspace:*",
    "@qilin-agent/goal": "workspace:*",
    "@qilin-agent/host-plugin-inventory": "workspace:*",
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/kylin-host-runner": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/mcp-servers": "workspace:*",
    "@qilin-agent/message-feedback": "workspace:*",
    "@qilin-agent/office-to-pdf": "workspace:*",
    "@qilin-agent/permission-presets": "workspace:*",
    "@qilin-agent/plugin-manager": "workspace:*",
    "@qilin-agent/schedule": "workspace:*",
    "@qilin-agent/scope": "workspace:*",
    "@qilin-agent/session-reference": "workspace:*",
    "@qilin-agent/settings": "workspace:*",
    "@qilin-agent/subagent": "workspace:*",
    "@qilin-agent/typert-protocol": "workspace:*",
    "@qilin-agent/user-approval": "workspace:*",
    "@qilin-agent/user-questions": "workspace:*",
    "zod": "^4.4.3"
  }
}
