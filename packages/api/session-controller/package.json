{
  "name": "@qilin-agent/api-session-controller",
  "description": "Session Remote commands, cold reads, and live control transport",
  "version": "3.1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/QiLin.git",
    "directory": "packages/api/session-controller"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./remote-events": {
      "types": "./lib/types/remote-events.d.ts",
      "default": "./lib/types/remote-events.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "qilin": {
    "client": {
      "external": [
        "@qilin-agent/api-gateway/client"
      ],
      "inject": [
        "@qilin-agent/api-gateway",
        "@qilin-agent/client-file-upload"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@qilin-agent/brand": "workspace:*",
    "@qilin-agent/deque": "workspace:*",
    "@qilin-agent/schemastery": "workspace:~",
    "mime-types": "^3.0.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/agent-default-model": "workspace:*",
    "@qilin-agent/agent-presets": "workspace:*",
    "@qilin-agent/api-gateway": "workspace:*",
    "@qilin-agent/attachment": "workspace:*",
    "@qilin-agent/client-connection": "workspace:*",
    "@qilin-agent/client-file-upload": "workspace:*",
    "@qilin-agent/commands": "workspace:*",
    "@qilin-agent/file-reference": "workspace:*",
    "@qilin-agent/fs": "workspace:*",
    "@qilin-agent/jobs": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/native-command": "workspace:*",
    "@qilin-agent/scope": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/session-persistence": "workspace:*",
    "@qilin-agent/session-projection": "workspace:*",
    "@qilin-agent/session-projection-cache": "workspace:*",
    "@qilin-agent/session-query": "workspace:*",
    "@qilin-agent/session-title": "workspace:*",
    "@qilin-agent/skill": "workspace:*",
    "@qilin-agent/subagent": "workspace:*",
    "@qilin-agent/typert-protocol": "workspace:*",
    "@qilin-agent/typert-registry": "workspace:*",
    "@qilin-agent/util-time": "workspace:*",
    "@qilin-agent/util-values": "workspace:*",
    "@qilin-agent/util-workspace-path": "workspace:*",
    "@qilin-agent/workspace": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@qilin-agent/jobs": {
      "optional": true
    },
    "@qilin-agent/session-persistence": {
      "optional": true
    },
    "@qilin-agent/session-projection-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "@qilin-agent/kylin": "workspace:~",
    "@qilin-agent/agent": "workspace:*",
    "@qilin-agent/agent-default-model": "workspace:*",
    "@qilin-agent/agent-loop": "workspace:*",
    "@qilin-agent/agent-loop-testkit": "workspace:*",
    "@qilin-agent/agent-presets": "workspace:*",
    "@qilin-agent/api-gateway": "workspace:*",
    "@qilin-agent/attachment": "workspace:*",
    "@qilin-agent/client-connection": "workspace:*",
    "@qilin-agent/client-file-upload": "workspace:*",
    "@qilin-agent/client-store": "workspace:*",
    "@qilin-agent/client-test-runtime": "workspace:*",
    "@qilin-agent/commands": "workspace:*",
    "@qilin-agent/file-reference": "workspace:*",
    "@qilin-agent/fs": "workspace:*",
    "@qilin-agent/fs-local": "workspace:*",
    "@qilin-agent/jobs": "workspace:*",
    "@qilin-agent/llm": "workspace:*",
    "@qilin-agent/native-command": "workspace:*",
    "@qilin-agent/permission-presets": "workspace:*",
    "@qilin-agent/remote-mock": "workspace:*",
    "@qilin-agent/scope": "workspace:*",
    "@qilin-agent/session": "workspace:*",
    "@qilin-agent/session-persistence": "workspace:*",
    "@qilin-agent/session-projection": "workspace:*",
    "@qilin-agent/session-projection-cache": "workspace:*",
    "@qilin-agent/session-query": "workspace:*",
    "@qilin-agent/session-title": "workspace:*",
    "@qilin-agent/skill": "workspace:*",
    "@qilin-agent/storage": "workspace:*",
    "@qilin-agent/storage-domain": "workspace:*",
    "@qilin-agent/storage-json": "workspace:*",
    "@qilin-agent/subagent": "workspace:*",
    "@qilin-agent/typert-protocol": "workspace:*",
    "@qilin-agent/typert-registry": "workspace:*",
    "@qilin-agent/util-crypto": "workspace:*",
    "@qilin-agent/util-time": "workspace:*",
    "@qilin-agent/util-values": "workspace:*",
    "@qilin-agent/util-workspace-path": "workspace:*",
    "@qilin-agent/workspace": "workspace:*",
    "@types/mime-types": "^3.0.1"
  }
}
