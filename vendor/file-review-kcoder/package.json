{
  "name": "dsh-file-review-kcoder",
  "description": "Standalone dsh plugin (maintained by dsh-external): review agent-produced file changes (line-level red/green diff + undo) as a chat turn-tail row and a coding-sidebar tab, alongside dsh's explicit `present` delivery cards. Lineage: originally a port of left0ver/dsh-file-review; previously maintained in-tree as @kcoder/file-review, now an independent release line. Adapted to dsh 0.1.2-alpha.1+ conversation snapshot routing and to the 0.1.5 turn-tail deliverables vocabulary.",
  "version": "1.0.3",
  "private": true,
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "diff",
    "code-review",
    "sidebar"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/types/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/types/remote.d.ts",
      "default": "./lib/remote.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/typert.host.js",
    "lib/remote.js",
    "lib/typert-descriptors.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "qilin": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@qilin/client-modules",
        "@qilin/client-locale",
        "@qilin/client-ui-conversation",
        "@qilin/coding-sidebar"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "diff": "^9.0.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@qilin/atomic-write": "workspace:^",
    "@qilin/kylin": "workspace:^",
    "@qilin/typert-protocol": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkutysllb/dsh-file-review-kcoder.git"
  }
}
