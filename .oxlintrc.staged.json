{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./.oxlintrc.json"],
  "options": {
    // This lane omits type information, so a directive that suppresses a
    // type-aware rule produces no diagnostic to observe and reads as unused.
    // The full-config lane owns directive freshness.
    "typeAware": false,
    "reportUnusedDisableDirectives": "off"
  },
  "ignorePatterns": [
    "**/lib/**",
    "**/node_modules/**",
    "**/.sessions/**",
    ".claude/**",
    "**/.doc-typecheck-*/**",
    "**/.node-next-types-*/**",
    "website/.generated/**",
    "vendor/**",
    "native/**",
    "**/*.js",
    "**/*.mjs",
    "**/*.config.ts",
    "packages/client/tsdown.client.ts"
  ]
}
