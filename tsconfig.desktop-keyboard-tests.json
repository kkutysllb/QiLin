{
  // The desktop keyboard integration fixture imports only Cordis-free Desktop
  // modules plus the Client shortcuts face; a dedicated leaf keeps that Client
  // program out of the Host aggregate (tsconfig.host.json excludes the spec).
  "extends": "./tsconfig.base.client.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "lib/desktop-keyboard-test-types",
    "emitDeclarationOnly": true,
    "types": ["node"]
  },
  "files": [
    "apps/desktop/tests/keyboard.spec.ts",
    "apps/desktop/src/keyboard.ts",
    "apps/desktop/src/keybindings.ts",
    "apps/desktop/src/ipc.ts"
  ],
  "include": [],
  "references": [
    { "path": "./packages/client/shortcuts/tsconfig.client.json" },
    { "path": "./packages/util/atomic-write" }
  ]
}
